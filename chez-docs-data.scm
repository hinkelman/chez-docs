et? e3 e1) " (math "=>") " #f" (br) "(enum-set-subset? e3 e2) " (math "=>") " #t"))) ("objects:s296" ((bold "procedure") ": " (code "(enum-set=? " (var "enum-set" (sub "1")) " " (var "enum-set" (sub "2")) ")") (br) (bold "returns: ") (code "#t") " if " (code (var "enum-set" (sub "1"))) " and " (code (var "enum-set" (sub "2"))) " are equivalent, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(rnrs enums)") ", " (code "(rnrs)")) ("Two enumeration sets " (code (var "enum-set" (sub "1"))) " and " (code (var "enum-set" (sub "2"))) " are equivalent if each is a subset of the other.") ((code "(define e1 (make-enumeration '(a b c d)))" (br) "(define e2 (make-enumeration '(b d c a)))" (br) "(enum-set=? e1 e2) " (math "=>") " #t" (br) "(define e3 ((enum-set-constructor e1) '(a c)))" (br) "(define e4 ((enum-set-constructor e2) '(a c)))" (br) "(enum-set=? e3 e4) " (math "=>") " #t" (br) "(enum-set=? e3 e2) " (math "=>") " #f")) ((code "enum-set=?") " could be defined in terms of " (code "enum-set-subset?") " as follows.") ((code "(define enum-set=?" (br) "  (lambda (e1 e2)" (br) "    (and (enum-set-subset? e1 e2) (enum-set-subset? e2 e1))))"))) ("objects:s297" ((bold "procedure") ": " (code "(enum-set-member? " (var "symbol") " " (var "enum-set") ")") (br) (bold "returns: ") (code "#t") " if symbol is an element of " (code (var "enum-set")) ", " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(rnrs enums)") ", " (code "(rnrs)")) ((code "(define e1 (make-enumeration '(a b c d e)))" (br) "(define e2 ((enum-set-constructor e1) '(d b)))" (br) "(enum-set-member? 'c e1) " (math "=>") " #t" (br) "(enum-set-member? 'c e2) " (math "=>") " #f"))) ("objects:s298" ((bold "procedure") ": " (code "(enum-set-union " (var "enum-set" (sub "1")) " " (var "enum-set" (sub "2")) ")") (br) (bold "returns: ") "the union of " (code (var "enum-set" (sub "1"))) " and " (code (var "enum-set" (sub "2"))) (br) (bold "procedure") ": " (code "(enum-set-intersection " (var "enum-set" (sub "1")) " " (var "enum-set" (sub "2")) ")") (br) (bold "returns: ") "the intersection of " (code (var "enum-set" (sub "1"))) " and " (code (var "enum-set" (sub "2"))) (br) (bold "procedure") ": " (code "(enum-set-difference " (var "enum-set" (sub "1")) " " (var "enum-set" (sub "2")) ")") (br) (bold "returns: ") "the difference of " (code (var "enum-set" (sub "1"))) " and " (code (var "enum-set" (sub "2"))) (br) (bold "libraries: ") (code "(rnrs enums)") ", " (code "(rnrs)")) ((code (var "enum-set" (sub "1"))) " and " (code (var "enum-set" (sub "2"))) " must have the same enumeration type. Each procedure returns a new enumeration set representing the union, intersection, or difference of the two sets.") ((code "(define e1 (make-enumeration '(a b c d)))" (br) "(define e2 ((enum-set-constructor e1) '(a c)))" (br) "(define e3 ((enum-set-constructor e1) '(b c)))" (br) "(enum-set->list (enum-set-union e2 e3)) " (math "=>") " (a b c)" (br) "(enum-set->list (enum-set-intersection e2 e3)) " (math "=>") " (c)" (br) "(enum-set->list (enum-set-difference e2 e3)) " (math "=>") " (a)" (br) "(enum-set->list (enum-set-difference e3 e2)) " (math "=>") " (b)" (br) "(define e4 (make-enumeration '(b d c a)))" (br) "(enum-set-union e1 e4) " (math "=>") " " (var "exception: different enumeration types")))) ("objects:s299" ((bold "procedure") ": " (code "(enum-set-complement " (var "enum-set") ")") (br) (bold "returns: ") "the complement of " (code (var "enum-set")) " relative to its universe" (br) (bold "libraries: ") (code "(rnrs enums)") ", " (code "(rnrs)")) ((code "(define e1 (make-enumeration '(a b c d)))" (br) "(enum-set->list (enum-set-complement e1)) " (math "=>") " ()" (br) "(define e2 ((enum-set-constructor e1) '(a c)))" (br) "(enum-set->list (enum-set-complement e2)) " (math "=>") " (b d)"))) ("objects:s300" ((bold "procedure") ": " (code "(enum-set-projection " (var "enum-set" (sub "1")) " " (var "enum-set" (sub "2")) ")") (br) (bold "returns: ") "the projection of " (code (var "enum-set" (sub "1"))) " into the universe of " (code (var "enum-set" (sub "2"))) (br) (bold "libraries: ") (code "(rnrs enums)") ", " (code "(rnrs)")) ("Any elements of " (code (var "enum-set" (sub "1"))) " not in the universe of " (code (var "enum-set" (sub "2"))) " are dropped. The result is of the same enumeration type as " (code (var "enum-set" (sub "2"))) ".") ((code "(define e1 (make-enumeration '(a b c d)))" (br) "(define e2 (make-enumeration '(a b c d e f g)))" (br) "(define e3 ((enum-set-constructor e1) '(a d)))" (br) "(define e4 ((enum-set-constructor e2) '(a c e g)))" (br) "(enum-set->list (enum-set-projection e4 e3)) " (math "=>") " (a c)" (br) "(enum-set->list" (br) "  (enum-set-union e3" (br) "    (enum-set-projection e4 e3))) " (math "=>") " (a c d)"))) ("objects:s301" ((bold "procedure") ": " (code "(enum-set-indexer " (var "enum-set") ")") (br) (bold "returns: ") "a procedure that returns the index of a symbol in the universe of " (code (var "enum-set")) (br) (bold "libraries: ") (code "(rnrs enums)") ", " (code "(rnrs)")) ((code "enum-set-indexer") " returns a procedure " (code (var "p")) " that, when applied to a symbol in the universe of " (code (var "enum-set")) ", returns the index of the symbol (zero-based) in the ordered set of symbols that form the universe. If applied to a symbol not in the universe, " (code (var "p")) " returns " (code "#f") ".") ((code "(define e1 (make-enumeration '(a b c d)))" (br) "(define e2 ((enum-set-constructor e1) '(a d)))" (br) "(define p (enum-set-indexer e2))" (br) "(list (p 'a) (p 'c) (p 'e)) " (math "=>") " (0 2 #f)"))) ("records:s13" ((bold "syntax") ": " (code "(define-record-type " (var "record-name") " " (var "clause") " ...)") (br) (bold "syntax") ": " (code "(define-record-type (" (var "record-name") " " (var "constructor") " " (var "pred") ") " (var "clause") " ...)") (br) (bold "libraries: ") (code "(rnrs records syntactic)") ", " (code "(rnrs)")) ("A " (code "define-record-type") " form, or " (var "record definition") ", is a definition and may appear anywhere other definitions may appear. It defines a record type identified by " (code (var "record-name")) ", plus a predicate, constructor, accessors, and mutators for the record type. If the record definition takes the first form above, the names of the constructor and predicate are derived from " (code (var "record-name")) ": " (code "make-" (var "record-name")) "  for the constructor and " (code (var "record-name") "?") " for the predicate. If the record definition takes the second form above, the name of the constructor is " (code (var "constructor")) " and the name of the predicate is " (code (var "pred")) ". All names defined by a record definition are scoped where the record definition appears.") ("The clauses " (code (var "clause") " ...") " of the record definition determine the fields of the record type and the names of their accessors and mutators; its parent type, if any; its construction protocol; whether it is nongenerative and, if so, whether its uid is specified; whether it is sealed; and whether it is opaque. The syntax and impact of each clause is described below.") ("None of the clauses is required; thus, the simplest record definition is") ((code "(define-record-type " (var "record-name") ")")) ("which defines a new, generative, non-sealed, non-opaque record type with no parent and no fields, plus a constructor of no arguments and a predicate.") ("At most one of each kind of clause may be present in the set of clauses, and if a " (code "parent") " clause is present, a " (code "parent-rtd") " clause must not be present. The clauses that appear may appear in any order.") ((bold "Fields clause.") "  A " (code "(fields " (var "field-spec") " ...)") " clause declares the fields of the record type. Each " (code (var "field-spec")) " must take one of the following forms:") ((code (var "field-name") (br) "(immmutable " (var "field-name") ")" (br) "(mutable " (var "field-name") ")" (br) "(immmutable " (var "field-name") " " (var "accessor-name") ")" (br) "(mutable " (var "field-name") " " (var "accessor-name") " " (var "mutator-name") ")")) ("where " (code (var "field-name")) ", " (code (var "accessor-name")) ", and " (code (var "mutator-name")) " are identifiers. The first form, " (code (var "field-name")) ", is equivalent to " (code "(immutable " (var "field-name") ")") ". The value of a field declared immutable may not be changed, and no mutator is created for it. With the first three forms, the name of the accessor is " (code (var "rname") "-" (var "fname")) ", where " (code (var "rname")) " is the record name and " (code (var "fname")) " is the field name. With the third form, the name of the accessor is " (code (var "rname") "-" (var "fname") "-set!") ". The fourth and fifth forms explicitly declare the accessor and mutator names.") ("If no " (code "fields") " clause is present or the list " (code (var "field-spec") " ...") "  is empty, the record type has no fields (other than parent fields, if any).") ((bold "Parent clause.") "  A " (code "(parent " (var "parent-name") ")") " clause declares the parent record type; " (code (var "parent-name")) " must be the name of a non-sealed record type previously defined via " (code "define-record-type") ". Instances of a record type are also considered instances of its parent record type and have all the fields of its parent record type in addition to those declared via the " (code "fields") " clause.") ((bold "Nongenerative clause.") "  A " (code "nongenerative") " clause may take one of two forms:") ((code "(nongenerative)" (br) "(nongenerative " (var "uid") ")")) ("where " (code (var "uid")) " is a symbol. The first form is equivalent to the second, with a uid generated by the implementation at macro-expansion time. When a " (code "define-record-type") " form with a nongenerative clause is evaluated, a new type is created if and only if the uid is not the uid of an existing record type.") ("If it is the uid of an existing record type, the parent, field-names, sealed property, and opaque property must match as follows.   " (ul (li "If a parent is specified, the existing record type must have the same parent rtd (by " (code "eqv?") "). If a parent is not specified, the existing record type must not have a parent.") (li "The same number of fields must be provided, with the same names and in the same order, and the mutability of each field must be the same.") (li "If a " (code "(sealed #t)") " clause is present, the existing record type must be sealed. Otherwise, the existing record type must not be sealed.") (li "If an " (code "(opaque #t)") " clause is present, the existing record type must be opaque. Otherwise, the existing record type must be opaque if and only if an opaque parent type is specified."))) ("If these constraints are met, no new record type is created, and the other products of the record-type definition (constructor, predicate, accessors, and mutators) operate on records of the existing type. If these constraints are not met, the implementation may treat it as a syntax violation, or it may raise a run-time exception with condition type " (code "&assertion") ".") ("With the first form of " (code "nongenerative") " clause, the generated uid can be the uid of an existing record type only if the same definition is executed multiple times, e.g., if it appears in the body of a procedure that is invoked multiple times.") ("If " (code (var "uid")) " is not the uid of an existing record type, or if no " (code "nongenerative") " clause is present, a new record type is created.") ((bold "Protocol clause.") "  A " (code "(protocol " (var "expression") ")") " determines the protocol that the generated constructor uses to construct instances of the record type. It must evaluate to a procedure, and this procedure should be an appropriate protocol for the record type, as described on page " (link "./records.html#page:protocols" "326") ".") ((bold "Sealed clause.") "  A " (code "sealed") " clause of the form " (code "(sealed #t)") " declares that the record type is " (var "sealed") ". This means that it cannot be extended, i.e., cannot be used as the parent for another record definition or " (code "make-record-type-descriptor") "  call. If no " (code "sealed") " clause is present or if one of the form " (code "(sealed #f)") " is present, the record type is not sealed.") ((bold "Opaque clause.") "  An " (code "opaque") " clause of the form " (code "(opaque #t)") " declares that the record type is " (var "opaque") ". Instances of an opaque record type are not considered records by the " (code "record?") " predicate or, more importantly, the rtd-extraction procedure " (code "record-rtd") ", which are both described in Section " (link "./records.html#g141" "9.3") ". Thus, it is not possible for code that does not have access to the " (code "record-name") ", accessors, or mutators to access or modify any of the fields of an opaque record type. A record type is also opaque if its parent is opaque. If no " (code "opaque") " clause is present or if one of the form " (code "(opaque #f)") " is present, and the parent, if any, is not opaque, the record type is not opaque.") ((bold "Parent-rtd clause.") "  A " (code "(parent-rtd " (var "parent-rtd") " " (var "parent-rcd") ")") " clause is an alternative to the " (code "parent") " clause for specifying the parent record type, along with a parent record constructor descriptor. It is primarily useful when the parent rtd and rcd were obtained via calls to " (code "make-record-type-descriptor") " and " (code "make-record-constructor-descriptor") ".") ((code (var "parent-rtd")) " must evaluate to an rtd or " (code "#f") ". If " (code (var "parent-rtd")) " evaluates to " (code "#f") ", " (code (var "parent-rcd")) " must also evaluate to " (code "#f") ". Otherwise, " (code (var "parent-rcd")) " must evaluate to an rcd or " (code "#f") ". If " (code (var "parent-rcd")) " evaluates to an rcd, it must encapsulate an rtd equivalent (by " (code "eqv?") ") to the value of " (code (var "parent-rtd")) ". If the value of " (code (var "parent-rcd")) " is " (code "#f") ", it is treated as an rcd for the value of " (code (var "parent-rtd")) " with a default protocol.") ("The " (code "define-record-type") " form is designed in such a way that it is normally possible for a compiler to determine the shapes of the record types it defines, including the offsets for all fields. This guarantee does not hold, however, when the " (code "parent-rtd") " clause is used, since the parent rtd might not be determinable until run time. Thus, the " (code "parent") " clause is preferred over the " (code "parent-rtd") "  clause whenever the " (code "parent") " clause suffices.")) ("records:s16" ((bold "syntax") ": " (code "fields") (br) (bold "syntax") ": " (code "mutable") (br) (bold "syntax") ": " (code "immutable") (br) (bold "syntax") ": " (code "parent") (br) (bold "syntax") ": " (code "protocol") (br) (bold "syntax") ": " (code "sealed") (br) (bold "syntax") ": " (code "opaque") (br) (bold "syntax") ": " (code "nongenerative") (br) (bold "syntax") ": " (code "parent-rtd") (br) (bold "libraries: ") (code "(rnrs records syntactic)") ", " (code "(rnrs)")) ("These identifiers are auxiliary keywords for " (code "define-record-type") ". It is a syntax violation to reference these identifiers except in contexts where they are recognized as auxiliary keywords.")) ("records:s20" ((bold "procedure") ": " (code "(make-record-type-descriptor " (var "name") " " (var "parent") " " (var "uid") " " (var "s?") " " (var "o?") " " (var "fields") ")") (br) (bold "returns: ") "a record-type descriptor (rtd) for a new or existing record type" (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ((code (var "name")) " must be a symbol, " (code (var "parent")) " must be " (code "#f") " or the rtd of a non-sealed record type, " (code (var "uid")) " must be " (code "#f") " or a symbol, and " (code (var "fields")) " must be a vector, each element of which is a two-element list of the form " (code "(mutable " (var "field-name") ")") "  or " (code "(immutable " (var "field-name") ")") ". The field names " (code (var "field-name") " ...") " must be symbols and need not be distinct from each other.") ("If " (code (var "uid")) " is " (code "#f") " or is not the uid of an existing record type, this procedure creates a new record type and returns a record-type descriptor (rtd) for the new type.  The type has the parent type (page " (link "./records.html#page:parent-type" "325") ") described by " (code (var "parent")) ", if nonfalse; the uid specified by " (code (var "uid")) ", if nonfalse; and the fields specified by " (code (var "fields")) ". It is sealed (page " (link "./records.html#page:sealed" "330") ") if " (code (var "s?")) " is nonfalse. It is opaque (page " (link "./records.html#page:opaque" "330") ") if " (code (var "opaque")) " is nonfalse or the parent (if specified) is opaque. The name of the new record type is " (code (var "name")) " and the names of the fields are " (code (var "field-name") " ...") ".") ("If " (code (var "uid")) " is nonfalse and is the uid (page " (link "./records.html#page:record-uid" "325") ") of an existing record type, the " (code (var "parent")) ", " (code (var "fields")) ", " (code (var "s?")) ", and " (code (var "o?")) " arguments must match the corresponding characteristics of the existing record type. That is, " (code (var "parent")) " must be the same (by " (code "eqv?") "); the number of fields must be the same; the fields must have the same names, be in the same order, and have the same mutability; " (code (var "s?")) " must be false if and only if the existing record type is sealed; and, if a parent is not specified or is not opaque, " (code (var "o?")) " must be false if and only if the existing record type is opaque. If this is the case, " (code "make-record-type-descriptor") "  returns the rtd for the existing record type. Otherwise, an exception with condition type " (code "&assertion") " is raised.") ("Using the rtd returned by " (code "make-record-type-descriptor") ", programs can generate constructors, type predicates, field accessors, and field mutators dynamically. The following code demonstrates how the procedural interface might be used to create a " (code "point") " record type and associated definitions similar to those of the second " (code "point") " record definition in Section " (link "./records.html#g139" "9.1") ", with a mutable " (code "x") " field and an immutable " (code "y") " field.") ((code "(define point-rtd (make-record-type-descriptor 'point #f #f #f #f" (br) "                '#((mutable x) (immutable y))))" (br) "(define point-rcd (make-record-constructor-descriptor point-rtd" (br) "                    #f #f))" (br) "(define make-point (record-constructor point-rcd))" (br) "(define point? (record-predicate point-rtd))" (br) "(define point-x (record-accessor point-rtd 0))" (br) "(define point-y (record-accessor point-rtd 1))" (br) "(define point-x-set! (record-mutator point-rtd 0))")) ("See the additional examples given at the end of this section.")) ("records:s23" ((bold "procedure") ": " (code "(record-type-descriptor? " (var "obj") ")") (br) (bold "returns: ") (code "#f") " if " (code (var "obj")) " is a record-type descriptor, otherwise " (code "#f") (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ("See the examples given at the end of this section.")) ("records:s24" ((bold "procedure") ": " (code "(make-record-constructor-descriptor " (var "rtd") " " (var "parent-rcd") " " (var "protocol") ")") (br) (bold "returns: ") "a record-constructor descriptor (rcd)" (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ("An rtd alone is sufficient to create predicates, accessors, and mutators. To create a constructor, however, it is first necessary to create a record-constructor descriptor (rcd) for the record type. An rcd encapsulates three pieces of information: the rtd of the record type for which the rcd has been created, the parent rcd (if any), and the protocol.") ("The " (code (var "parent-rcd")) " argument must be an rcd or " (code "#f") ". If it is an rcd, " (code (var "rtd")) " must have a parent rtd, and the parent rtd must be the same as the rtd encapsulated within " (code (var "parent-rcd")) ". If " (code (var "parent-rcd")) " is false, either " (code (var "rtd")) " has no parent or an rcd with a default protocol is assumed for the parent.") ("The " (code (var "protocol")) " argument must be a procedure or " (code "#f") ". If it is " (code "#f") ", a default protocol is assumed. Protocols are discussed on page " (link "./records.html#page:protocols" "326") ".") ("See the examples given at the end of this section.")) ("records:s28" ((bold "syntax") ": " (code "(record-type-descriptor " (var "record-name") ")") (br) (bold "returns: ") "the rtd for the record type identified by " (code "record-name") (br) (bold "syntax") ": " (code "(record-constructor-descriptor " (var "record-name") ")") (br) (bold "returns: ") "the rcd for the record type identified by " (code "record-name") (br) (bold "libraries: ") (code "(rnrs records syntactic)") ", " (code "(rnrs)")) ("Each record definition creates, behind the scenes, an rtd and rcd for the defined record type. These procedures allow the rtd and rcd to be obtained and used like any other rtd or rcd. " (code (var "record-name")) " must be the name of a record previously defined via " (code "define-record-type") ".")) ("records:s29" ((bold "procedure") ": " (code "(record-constructor " (var "rcd") ")") (br) (bold "returns: ") "a record constructor for the record type encapsulated within " (code (var "rcd")) (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ("The behavior of the record constructor is determined by the protocol and parent rcd (if any) also encapsulated within " (code (var "rcd")) ".") ("See the examples given at the end of this section.")) ("records:s30" ((bold "procedure") ": " (code "(record-predicate " (var "rtd") ")") (br) (bold "returns: ") "a predicate for " (code (var "rtd")) (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ("This procedure returns a predicate that accepts one argument and returns " (code "#t") " if the argument is an instance of the record-type described by " (code (var "rtd")) ", " (code "#f") " otherwise.") ("See the examples given at the end of this section.")) ("records:s31" ((bold "procedure") ": " (code "(record-accessor " (var "rtd") " " (var "idx") ")") (br) (bold "returns: ") "an accessor for the field of " (code (var "rtd")) " specified by " (code (var "idx")) (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ((code (var "idx")) " must be a nonnegative integer less than the number of fields of " (code (var "rtd")) ", not counting parent fields. An " (code (var "idx")) " value of 0 specifies the first field given in the " (code "define-record-type") " form or " (code "make-record-type-descriptor") "  call that created the record type, 1 specifies the second, and so on.") ("A child rtd cannot be used directly to create accessors for parent fields. To create an accessor for a parent field, the record-type descriptor of the parent must be used instead.") ("See the examples given at the end of this section.")) ("records:s32" ((bold "procedure") ": " (code "(record-mutator " (var "rtd") " " (var "idx") ")") (br) (bold "returns: ") "a mutator for the field of " (code (var "rtd")) " specified by " (code (var "idx")) (br) (bold "libraries: ") (code "(rnrs records procedural)") ", " (code "(rnrs)")) ((code (var "idx")) " must be a nonnegative integer less than the number of fields of " (code (var "rtd")) ", not counting parent fields. An " (code (var "idx")) " value of 0 specifies the first field given in the " (code "define-record-type") " form or " (code "make-record-type-descriptor") "  call that created the record type, 1 specifies the second, and so on. The indicated field must be mutable; otherwise, an exception with condition type " (code "&assertion") " is raised.") ("A child rtd cannot be used directly to create mutators for parent fields. To create a mutator for a parent field, the record-type descriptor of the parent must be used instead.") ("The following example illustrates the creation of parent and child record types, predicates, accessors, mutators, and constructors using the procedures described in this section.") ((code "(define rtd/parent" (br) "  (make-record-type-descriptor 'parent #f #f #f #f" (br) "    '#((mutable x))))" (br) (br) "(record-type-descriptor? rtd/parent) " (math "=>") " #t" (br) "(define parent? (record-predicate rtd/parent))" (br) "(define parent-x (record-accessor rtd/parent 0))" (br) "(define set-parent-x! (record-mutator rtd/parent 0))" (br) (br) "(define rtd/child" (br) "  (make-record-type-descriptor 'child rtd/parent #f #f #f" (br) "    '#((mutable x) (immutable y))))" (br) (br) "(define child? (record-predicate rtd/child))" (br) "(define child-x (record-accessor rtd/child 0))" (br) "(define set-child-x! (record-mutator rtd/child 0))" (br) "(define child-y (record-accessor rtd/child 1))" (br) (br) "(record-mutator rtd/child 1) " (math "=>") " " (var "exception: immutable field") (br) (br) "(define rcd/parent" (br) "  (make-record-constructor-descriptor rtd/parent #f" (br) "    (lambda (new) (lambda (x) (new (* x x))))))" (br) (br) "(record-type-descriptor? rcd/parent) " (math "=>") " #f" (br) (br) "(define make-parent (record-constructor rcd/parent))" (br) (br) "(define p (make-parent 10))" (br) "(parent? p) " (math "=>") " #t" (br) "(parent-x p) " (math "=>") " 100" (br) "(set-parent-x! p 150)" (br) "(parent-x p) " (math "=>") " 150" (br) (br) "(define rcd/child" (br) "  (make-record-constructor-descriptor rtd/child rcd/parent" (br) "    (lambda (pargs->new)" (br) "      (lambda (x y)" (br) "        ((pargs->new x) (+ x 5) y)))))" (br) (br) "(define make-child (record-constructor rcd/child))" (br) "(define c (make-child 10 'cc))" (br) "(parent? c) " (math "=>") " #t" (br) "(child? c) " (math "=>") " #t" (br) "(child? p) " (math "=>") " #f" (br) (br) "(parent-x c) " (math "=>") " 100" (br) "(child-x c) " (math "=>") " 15" (br) "(child-y c) " (math "=>") " cc" (br) (br) "(child-x p) " (math "=>") " " (var "exception: invalid argument type")))) ("records:s34" ((bold "procedure") ": " (code "(record-type-name " (var "rtd") ")") (br) (bold "returns: ") "the name associated with " (code (var "rtd")) (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ((code "(define record->name" (br) "  (lambda (x)" (br) "    (and (record? x) (record-type-name (record-rtd x)))))" (br) (br) "(define-record-type dim (fields w l h))" (br) "(record->name (make-dim 10 15 6)) " (math "=>") " dim" (br) (br) "(define-record-type dim (fields w l h) (opaque #t))" (br) "(record->name (make-dim 10 15 6)) " (math "=>") " #f"))) ("records:s35" ((bold "procedure") ": " (code "(record-type-parent " (var "rtd") ")") (br) (bold "returns: ") "the parent of " (code (var "rtd")) ", or " (code "#f") " if it has no parent" (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ((code "(define-record-type point (fields x y))" (br) "(define-record-type cpoint (parent point) (fields color))" (br) "(record-type-parent (record-type-descriptor point)) " (math "=>") " #f" (br) "(record-type-parent (record-type-descriptor cpoint)) " (math "=>") " #<rtd>"))) ("records:s36" ((bold "procedure") ": " (code "(record-type-uid " (var "rtd") ")") (br) (bold "returns: ") "the uid of " (code (var "rtd")) ", or " (code "#f") " if it has no uid" (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ("Whether a record type created without a programmer-supplied uid actually has one anyway is left up to the implementation, so this procedure is never guaranteed to return " (code "#f") ".") ((code "(define-record-type point (fields x y))" (br) "(define-record-type cpoint" (br) "  (parent point)" (br) "  (fields color)" (br) "  (nongenerative e40cc926-8cf4-4559-a47c-cac636630314))" (br) "(record-type-uid (record-type-descriptor point)) " (math "=>") " " (var "unspecified") (br) "(record-type-uid (record-type-descriptor cpoint)) " (math "=>") (br) "                             e40cc926-8cf4-4559-a47c-cac636630314"))) ("records:s37" ((bold "procedure") ": " (code "(record-type-generative? " (var "rtd") ")") (br) (bold "returns: ") (code "#t") " if the record type described by " (code (var "rtd")) " is generative, " (code "#f") " otherwise" (br) (bold "procedure") ": " (code "(record-type-sealed? " (var "rtd") ")") (br) (bold "returns: ") (code "#t") " if the record type described by " (code (var "rtd")) " is sealed, " (code "#f") " otherwise" (br) (bold "procedure") ": " (code "(record-type-opaque? " (var "rtd") ")") (br) (bold "returns: ") (code "#t") " if the record type described by " (code (var "rtd")) " is opaque, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ((code "(define-record-type table" (br) "  (fields keys vals)" (br) "  (opaque #t))" (br) "(define rtd (record-type-descriptor table))" (br) "(record-type-generative? rtd) " (math "=>") " #t" (br) "(record-type-sealed? rtd) " (math "=>") " #f" (br) "(record-type-opaque? rtd) " (math "=>") " #t" (br) (br) "(define-record-type cache-table" (br) "  (parent table)" (br) "  (fields key val)" (br) "  (nongenerative))" (br) "(define rtd (record-type-descriptor cache-table))" (br) "(record-type-generative? rtd) " (math "=>") " #f" (br) "(record-type-sealed? rtd) " (math "=>") " #f" (br) "(record-type-opaque? rtd) " (math "=>") " #t"))) ("records:s38" ((bold "procedure") ": " (code "(record-type-field-names " (var "rtd") ")") (br) (bold "returns: ") "a vector containing the names of the fields of the type described by " (code (var "rtd")) (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ("The vector returned by this procedure is immutable: the effect on " (code (var "rtd")) "  of modifying it is unspecified. The vector does not include parent field names. The order of the names in the vector is the same as the order in which the fields were specified in the " (code "define-record-type") " form or " (code "make-record-type-descriptor") " call that created the record type.") ((code "(define-record-type point (fields x y))" (br) "(define-record-type cpoint (parent point) (fields color))" (br) "(record-type-field-names" (br) "  (record-type-descriptor point)) " (math "=>") " #(x y)" (br) "(record-type-field-names" (br) "  (record-type-descriptor cpoint)) " (math "=>") " #(color)"))) ("records:s39" ((bold "procedure") ": " (code "(record-field-mutable? " (var "rtd") " " (var "idx") ")") (br) (bold "returns: ") (code "#t if the specified field of " (var "rtd")) " is mutable, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ((code (var "idx")) " must be a nonnegative integer less than the number of fields of " (code (var "rtd")) ", not counting parent fields. An " (code (var "idx")) " value of 0 specifies the first field given in the " (code "define-record-type") " form or " (code "make-record-type-descriptor") "  call that created the record type, 1 specifies the second, and so on.") ((code "(define-record-type point (fields (mutable x) (mutable y)))" (br) "(define-record-type cpoint (parent point) (fields color))" (br) (br) "(record-field-mutable? (record-type-descriptor point) 0) " (math "=>") " #t" (br) "(record-field-mutable? (record-type-descriptor cpoint) 0) " (math "=>") " #f"))) ("records:s40" ((bold "procedure") ": " (code "(record? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is a non-opaque record instance, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ("When passed an instance of an opaque record type, " (code "record?") " returns " (code "#f") ". While an instance of an opaque record type is, in essence, a record, the point of opacity is to hide all representation information from the parts of a program that should not have access to the information, and this includes whether an object is a record. Furthermore, the primary purpose of this predicate is to allow programs to check whether it is possible to obtain from the argument an rtd via the " (code "record-rtd") " procedure described below.") ((code "(define-record-type statement (fields str))" (br) "(define q (make-statement \"He's dead, Jim\"))" (br) "(statement? q) " (math "=>") " #t" (br) "(record? q) " (math "=>") " #t" (br) (br) "(define-record-type opaque-statement (fields str) (opaque #t))" (br) "(define q (make-opaque-statement \"He's moved on, Jim\"))" (br) "(opaque-statement? q) " (math "=>") " #t" (br) "(record? q) " (math "=>") " #f"))) ("records:s41" ((bold "procedure") ": " (code "(record-rtd " (var "record") ")") (br) (bold "returns: ") "the record-type descriptor (rtd) of " (code (var "record")) (br) (bold "libraries: ") (code "(rnrs records inspection)") ", " (code "(rnrs)")) ("The argument must be an instance of a non-opaque record type. In combination with some of the other procedures described in this section and Section " (link "./records.html#g140" "9.2") ", " (code "record-rtd") " allows the inspection or mutation of record instances, even if the type of the instance is unknown to the inspector. This capability is illustrated by the procedure " (code "print-fields") "  below, which accepts a record argument and writes the name and value of each field of the record.") ((code "(define print-fields" (br) "  (lambda (r)" (br) "    (unless (record? r)" (br) "      (assertion-violation 'print-fields \"not a record\" r))" (br) "    (let loop ([rtd (record-rtd r)])" (br) "      (let ([prtd (record-type-parent rtd)])" (br) "        (when prtd (loop prtd)))" (br) "      (let* ([v (record-type-field-names rtd)]" (br) "             [n (vector-length v)])" (br) "        (do ([i 0 (+ i 1)])" (br) "            ((= i n))" (br) "          (write (vector-ref v i))" (br) "          (display \"=\")" (br) "          (write ((record-accessor rtd i) r))" (br) "          (newline))))))")) ("With the familiar definitions of " (code "point") " and " (code "cpoint") ":") ((code "(define-record-type point (fields x y))" (br) "(define-record-type cpoint (parent point) (fields color))")) ("the expression " (code "(print-fields (make-cpoint -3 7 'blue))") " displays the following three lines.") ((code "x=-3" (br) "y=7" (br) "color=blue"))) ("syntax:s12" ((bold "syntax") ": " (code "(define-syntax " (var "keyword") " " (var "expr") ")") (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ((code (var "expr")) " must evaluate to a transformer.") ("The following example defines " (code "let*") " as a syntactic extension, specifying the transformer with " (code "syntax-rules") " (see Section " (link "./syntax.html#g135" "8.2") ").") ((code "(define-syntax let*" (br) "  (syntax-rules ()" (br) "    [(_ () b1 b2 ...) (let () b1 b2 ...)]" (br) "    [(_ ((i1 e1) (i2 e2) ...) b1 b2 ...)" (br) "     (let ([i1 e1])" (br) "       (let* ([i2 e2] ...) b1 b2 ...))]))")) ("All bindings established by a set of internal definitions, whether keyword or variable definitions, are visible everywhere within the immediately enclosing body, including within the definitions themselves. For example, the expression") ((code "(let ()" (br) "  (define even?" (br) "    (lambda (x)" (br) "      (or (= x 0) (odd? (- x 1)))))" (br) "  (define-syntax odd?" (br) "    (syntax-rules ()" (br) "      [(_ x) (not (even? x))]))" (br) "  (even? 10))")) ("is valid and should evaluate to " (code "#t") ".") ("The expander processes the initial forms in a " (code "library") ", " (code "lambda") ", or other body from left to right. If it encounters a variable definition, it records the fact that the defined identifier is a variable but defers expansion of the right-hand-side expression until after all of the definitions have been processed. If it encounters a keyword definition, it expands and evaluates the right-hand-side expression and binds the keyword to the resulting transformer. If it encounters an expression, it fully expands all deferred right-hand-side expressions along with the current and remaining body expressions.") ("An implication of the left-to-right processing order is that one internal definition can affect whether a subsequent form is also a definition. For example, the expression") ((code "(let ()" (br) "  (define-syntax bind-to-zero" (br) "    (syntax-rules ()" (br) "      [(_ id) (define id 0)]))" (br) "  (bind-to-zero x)" (br) "  x)")) ("evaluates to " (code "0") ", regardless of any binding for " (code "bind-to-zero") " that might appear outside of the " (code "let") "  expression.")) ("syntax:s13" ((bold "syntax") ": " (code "(let-syntax ((" (var "keyword") " " (var "expr") ") ...) " (var "form" (sub "1")) " " (var "form" (sub "2")) " ...)") (br) (bold "syntax") ": " (code "(letrec-syntax ((" (var "keyword") " " (var "expr") ") ...) " (var "form" (sub "1")) " " (var "form" (sub "2")) " ...)") (br) (bold "returns: ") "see below" (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ("Each " (code (var "expr")) " must evaluate to a transformer. For " (code "let-syntax") " and " (code "letrec-syntax") " both, each " (code (var "keyword")) "  is bound within the forms " (code (var "form" (sub "1")) " " (var "form" (sub "2")) " ...") ". For " (code "letrec-syntax") " the binding scope also includes each " (code (var "expr")) ".") ("A " (code "let-syntax") " or " (code "letrec-syntax") " form may expand into one or more expressions anywhere expressions are permitted, in which case the resulting expressions are treated as if enclosed in a " (code "begin") "  expression. It may also expand into zero or more definitions anywhere definitions are permitted, in which case the definitions are treated as if they appeared in place of the " (code "let-syntax") " or " (code "letrec-syntax") " form.") ("The following example highlights how " (code "let-syntax") "  and " (code "letrec-syntax") " differ.") ((code "(let ([f (lambda (x) (+ x 1))])" (br) "  (let-syntax ([f (syntax-rules ()" (br) "                       [(_ x) x])]" (br) "               [g (syntax-rules ()" (br) "                       [(_ x) (f x)])])" (br) "    (list (f 1) (g 1)))) " (math "=>") " (1 2)" (br) (br) "(let ([f (lambda (x) (+ x 1))])" (br) "  (letrec-syntax ([f (syntax-rules ()" (br) "                       [(_ x) x])]" (br) "                  [g (syntax-rules ()" (br) "                       [(_ x) (f x)])])" (br) "    (list (f 1) (g 1)))) " (math "=>") " (1 1)")) ("The two expressions are identical except that the " (code "let-syntax") " form in the first expression is a " (code "letrec-syntax") " form in the second. In the first expression, the " (code "f") " occurring in " (code "g") " refers to the " (code "let") "-bound variable " (code "f") ", whereas in the second it refers to the keyword " (code "f") " whose binding is established by the " (code "letrec-syntax") " form.")) ("syntax:s14" ((bold "syntax") ": " (code "(syntax-rules (" (var "literal") " ...) " (var "clause") " ...)") (br) (bold "returns: ") "a transformer" (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ("Each " (code (var "literal")) " must be an identifier other than an underscore ( " (code "_") " ) or ellipsis ( " (code "...") " ). Each clause must take the form below.") ((code "(" (var "pattern") " " (var "template") ")")) ("Each " (code (var "pattern")) " specifies one possible syntax that the input form might take, and the corresponding " (code (var "template")) " specifies how the output should appear.") ("Patterns consist of list structure, vector structure, identifiers, and constants. Each identifier within a pattern is either a " (code (var "literal")) ", a " (var "pattern variable") ", an " (var "underscore") ", or an " (var "ellipsis") ". The identifier " (code "_") " is an underscore, and the identifier " (code "...") " is an ellipsis. Any identifier other than " (code "_") " or " (code "...") " is a literal if it appears in the list of literals " (code "(" (var "literal") " ...)") "; otherwise, it is a pattern variable. Literals serve as auxiliary keywords, such as " (code "else") " in " (code "case") " and " (code "cond") " expressions. List and vector structure within a pattern specifies the basic structure required of the input, the underscore and pattern variables specify arbitrary substructure, and literals and constants specify atomic pieces that must match exactly. Ellipses specify repeated occurrences of the subpatterns they follow.") ("An input form " (code (var "F")) " matches a pattern " (code (var "P")) " if and only if   " (ul (li (code (var "P")) " is an underscore or pattern variable,") (li (code (var "P")) " is a literal identifier and " (code (var "F")) " is an identifier with the same binding as determined by the predicate " (code "free-identifier=?") "  (Section " (link "./syntax.html#g136" "8.3") "),") (li (code (var "P")) " is of the form " (code "(" (var "P" (sub "1")) " ... " (var "P" (sub "n")) ")") "  and " (code (var "F")) " is a list of " (var "n") " elements that match " (code (var "P" (sub "1"))) " through " (code (var "P" (sub "n"))) ",") (li (code (var "P")) " is of the form " (code "(" (var "P" (sub "1")) " ... " (var "P" (sub "n")) " . " (var "P" (sub "x")) ")") "  and " (code (var "F")) " is a list or improper list of " (var "n") " or more elements whose first " (var "n") " elements match " (code (var "P" (sub "1"))) " through " (code (var "P" (sub "n"))) "  and whose " (var "n") "th cdr matches " (code (var "P" (sub "x"))) ",") (li (code (var "P")) " is of the form " (code "(" (var "P" (sub "1")) " ... " (var "P" (sub "k")) " " (var "P" (sub "e")) " " (var "ellipsis") " " (var "P" (sub (var "m") "+1")) " ... " (var "P" (sub "n")) ")") ", where " (code (var "ellipsis")) " is the identifier " (code "...") "  and " (code (var "F")) " is a proper list of " (var "n") "  elements whose first " (var "k") " elements match " (code (var "P" (sub "1"))) " through " (code (var "P" (sub "k"))) ", whose next " (var "m") " - " (var "k") " elements each match " (code (var "P" (sub "e"))) ", and whose remaining " (var "n") " - " (var "m") " elements match " (code (var "P" (sub (var "m") "+1"))) " through " (code (var "P" (sub "n"))) ",") (li (code (var "P")) " is of the form " (code "(" (var "P" (sub "1")) " ... " (var "P" (sub "k")) " " (var "P" (sub "e")) " " (var "ellipsis") " " (var "P" (sub (var "m") "+1")) " ... " (var "P" (sub "n")) " . " (var "P" (sub "x")) ")") ", where " (code (var "ellipsis")) " is the identifier " (code "...") "  and " (code (var "F")) " is a list or improper list of " (var "n") "  elements whose first " (var "k") " elements match " (code (var "P" (sub "1"))) " through " (code (var "P" (sub "k"))) ", whose next " (var "m") " - " (var "k") " elements each match " (code (var "P" (sub "e"))) ", whose next " (var "n") " - " (var "m") " elements match " (code (var "P" (sub (var "m") "+1"))) " through " (code (var "P" (sub "n"))) ", and  whose " (var "n") "th and final cdr matches " (code (var "P" (sub "x"))) ",") (li (code (var "P")) " is of the form " (code "#(" (var "P" (sub "1")) " ... " (var "P" (sub "n")) ")") "  and " (code (var "F")) " is a vector of " (var "n") " elements that match " (code (var "P" (sub "1"))) " through " (code (var "P" (sub "n"))) ",") (li (code (var "P")) " is of the form " (code "#(" (var "P" (sub "1")) " ... " (var "P" (sub "k")) " " (var "P" (sub "e")) " " (var "ellipsis") " " (var "P" (sub (var "m") "+1")) " ... " (var "P" (sub "n")) ")") ", where " (code (var "ellipsis")) " is the identifier " (code "...") "  and " (code (var "F")) " is a vector of " (var "n") " elements whose first " (var "k") " elements match " (code (var "P" (sub "1"))) " through " (code (var "P" (sub "k"))) ", whose next " (var "m") " - " (var "k") " elements each match " (code (var "P" (sub "e"))) ", and whose remaining " (var "n") " - " (var "m") " elements match " (code (var "P" (sub (var "m") "+1"))) " through " (code (var "P" (sub "n"))) ", or") (li (code (var "P")) " is a pattern datum (any nonlist, nonvector, nonsymbol object) and " (code (var "F")) " is equal to " (code (var "P")) " in the sense of the " (code "equal?") " procedure."))) ("The outermost structure of a " (code "syntax-rules") " " (code (var "pattern")) "  must actually be in one of the list-structured forms above, although subpatterns of the pattern may be in any of the above forms. Furthermore, the first element of the outermost pattern is ignored, since it is always assumed to be the keyword naming the syntactic form. (These statements do not apply to " (code "syntax-case") "; see Section " (link "./syntax.html#g136" "8.3") ".)") ("If an input form passed to a " (code "syntax-rules") " transformer matches the pattern for a given clause, the clause is accepted and the form is transformed as specified by the associated template. As this transformation takes place, pattern variables appearing in the pattern are bound to the corresponding input subforms. Pattern variables appearing within a subpattern followed by one or more ellipses may be bound to a sequence or sequences of zero or more input subforms.") ("A template is a pattern variable, an identifier that is not a pattern variable, a pattern datum, a list of subtemplates " (code "(" (var "S" (sub "1")) " ... " (var "S" (sub "n")) ")") ", an improper list of subtemplates " (code "(" (var "S" (sub "1")) " " (var "S" (sub "2")) " ... " (var "S" (sub "n")) " . " (var "T") ")") ", or a vector of subtemplates " (code "#(" (var "S" (sub "1")) " ... " (var "S" (sub "n")) ")") ". Each subtemplate " (code (var "S" (sub "i"))) " is a template followed by zero or more ellipses. The final element " (code (var "T")) " of an improper subtemplate list is a template.") ("Pattern variables appearing within a template are replaced in the output by the input subforms to which they are bound. Pattern data and identifiers that are not pattern variables are inserted directly into the output. List and vector structure within the template remains list and vector structure in the output. A subtemplate followed by an ellipsis expands into zero or more occurrences of the subtemplate. The subtemplate must contain at least one pattern variable from a subpattern followed by an ellipsis. (Otherwise, the expander could not determine how many times the subform should be repeated in the output.) Pattern variables that occur in subpatterns followed by one or more ellipses may occur only in subtemplates that are followed by (at least) as many ellipses. These pattern variables are replaced in the output by the input subforms to which  they are bound, distributed as specified. If a pattern variable is followed by more ellipses in the template than in the associated pattern, the input form is replicated as necessary.") ("A template of the form " (code "(... " (var "template") ")") " is identical to " (code (var "template")) ", except that ellipses within the template have no special meaning. That is, any ellipses contained within " (code (var "template")) " are treated as ordinary identifiers. In particular, the template " (code "(... ...)") " produces a single ellipsis, " (code "...") ". This allows syntactic extensions to expand into forms containing ellipses, including " (code "syntax-rules") " or " (code "syntax-case") "  patterns and templates.") ("The definition of " (code "or") " below demonstrates the use of " (code "syntax-rules") ".") ((code "(define-syntax or" (br) "  (syntax-rules ()" (br) "    [(_) #f]" (br) "    [(_ e) e]" (br) "    [(_ e1 e2 e3 ...)" (br) "     (let ([t e1]) (if t t (or e2 e3 ...)))]))")) ("The input patterns specify that the input must consist of the keyword and zero or more subexpressions. An underscore ( " (code "_") " ), which is a special pattern symbol that matches any input, is often used for the keyword position to remind the programmer and anyone reading the definition that the keyword position never fails to contain the expected keyword and need not be matched. (In fact, as mentioned above, " (code "syntax-rules") " ignores what appears in the keyword position.) If more than one subexpression is present (third clause), the expanded code both tests the value of the first subexpression and returns the value if it is not false. To avoid evaluating the expression twice, the transformer introduces a binding for the temporary variable " (code "t") ".") ("The expansion algorithm maintains lexical scoping automatically by renaming local identifiers as necessary. Thus, the binding for " (code "t") " introduced by the transformer is visible only within code introduced by the transformer and not within subforms of the input. Similarly, the references to the identifiers " (code "let") " and " (code "if") " are unaffected by any bindings present in the context of the input.") ((code "(let ([if #f])" (br) "  (let ([t 'okay])" (br) "    (or if t))) " (math "=>") " okay")) ("This expression is transformed during expansion to the equivalent of the expression below.") ((code "((lambda (if1)" (br) "   ((lambda (t1)" (br) "      ((lambda (t2)" (br) "         (if t2 t2 t1))" (br) "       if1))" (br) "    'okay))" (br) " #f) " (math "=>") " okay")) ("In this sample expansion, " (code "if1") ", " (code "t1") ", and " (code "t2") "  represent identifiers to which " (code "if") " and " (code "t") " in the original expression and " (code "t") " in the expansion of " (code "or") " have been renamed.") ("The definition of a simplified version of " (code "cond") " below (simplified because it requires at least one output expression per clause and  does not support the auxiliary keyword " (code "=>") ") demonstrates how auxiliary keywords such as " (code "else") " are recognized in the input to a transformer, via inclusion in the list of literals.") ((code "(define-syntax cond" (br) "  (syntax-rules (else)" (br) "    [(_ (else e1 e2 ...)) (begin e1 e2 ...)]" (br) "    [(_ (e0 e1 e2 ...)) (if e0 (begin e1 e2 ...))]" (br) "    [(_ (e0 e1 e2 ...) c1 c2 ...)" (br) "     (if e0 (begin e1 e2 ...) (cond c1 c2 ...))]))"))) ("syntax:s26" ((bold "syntax") ": " (code "_") (br) (bold "syntax") ": " (code "...") (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("These identifiers are auxiliary keywords for " (code "syntax-rules") ", " (code "identifier-syntax") ", and " (code "syntax-case") ". The second ( " (code "...") " ) is also an auxiliary keyword for " (code "syntax") " and " (code "quasisyntax") ". It is a syntax violation to reference these identifiers except in contexts where they are recognized as auxiliary keywords.")) ("syntax:s27" ((bold "syntax") ": " (code "(identifier-syntax " (var "tmpl") ")") (br) (bold "syntax") ": " (code "(identifier-syntax (" (var "id" (sub "1")) " " (var "tmpl" (sub "1")) ") ((set! " (var "id" (sub "2")) " " (var "e" (sub "2")) ") " (var "tmpl" (sub "2")) "))") (br) (bold "returns: ") "a transformer" (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ("When a keyword is bound to a transformer produced by the first form of " (code "identifier-syntax") ", references to the keyword within the scope of the binding are replaced by " (code (var "tmpl")) ".") ((code "(let ()" (br) "  (define-syntax a (identifier-syntax car))" (br) "  (list (a '(1 2 3)) a)) " (math "=>") " (1 #<procedure>)")) ("With the first form of " (code "identifier-syntax") ", an apparent assignment of the associated keyword with " (code "set!") " is a syntax violation. The second, more general, form of " (code "identifier-syntax") " permits the transformer to specify what happens when " (code "set!") " is used.") ((code "(let ([ls (list 0)])" (br) "  (define-syntax a" (br) "    (identifier-syntax" (br) "      [id (car ls)]" (br) "      [(set! id e) (set-car! ls e)]))" (br) "  (let ([before a])" (br) "    (set! a 1)" (br) "    (list before a ls))) " (math "=>") " (0 1 (1))")) ("A definition of " (code "identifier-syntax") " in terms of " (code "make-variable-transformer") " is shown on page " (link "./syntax.html#defn:identifier-syntax" "307") ".")) ("syntax:s30" ((bold "syntax") ": " (code "(syntax-case " (var "expr") " (" (var "literal") " ...) " (var "clause") " ...)") (br) (bold "returns: ") "see below" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("Each " (code (var "literal")) " must be an identifier. Each " (code (var "clause")) " must take one of the following two forms.") ((code "(" (var "pattern") " " (var "output-expression") ")" (br) "(" (var "pattern") " " (var "fender") " " (var "output-expression") ")")) ((code "syntax-case") " patterns may be in any of the forms described in Section " (link "./syntax.html#g135" "8.2") ".") ((code "syntax-case") " first evaluates " (code (var "expr")) ", then attempts to match the resulting value against the pattern from the first " (code (var "clause")) ". This value may be any Scheme object. If the value matches the pattern and no " (code (var "fender")) " is present, " (code (var "output-expression")) " is evaluated and its values returned as the values of the " (code "syntax-case") " expression. If the value does not match the pattern, the value is compared against the next clause, and so on. It is a syntax violation if the value does not match any of the patterns.") ("If the optional " (code (var "fender")) " is present, it serves as an additional constraint on acceptance of a clause. If the value of the " (code "syntax-case") " " (code (var "expr")) " matches the pattern for a given clause, the corresponding " (code (var "fender")) " is evaluated. If " (code (var "fender")) " evaluates to a true value, the clause is accepted; otherwise, the clause is rejected as if the input had failed to match the pattern. Fenders are logically a part of the matching process, i.e., they specify additional matching constraints beyond the basic structure of an expression.") ("Pattern variables contained within a clause's " (code (var "pattern")) " are bound to the corresponding pieces of the input value within the clause's " (code (var "fender")) " (if present) and " (code (var "output-expression")) ". Pattern variables occupy the same namespace as program variables and keywords; pattern variable bindings created by " (code "syntax-case") "  can shadow (and be shadowed by) program variable and keyword bindings as well as other pattern variable bindings. Pattern variables, however, can be referenced only within " (code "syntax") "  expressions.") ("See the examples following the description of " (code "syntax") ".")) ("syntax:s33" ((bold "syntax") ": " (code "(syntax " (var "template") ")") (br) (bold "syntax") ": " (code "#'" (var "template")) (br) (bold "returns: ") "see below" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ((code "#'" (var "template")) " is equivalent to " (code "(syntax " (var "template") ")") ". The abbreviated form is converted into the longer form when a program is read, prior to macro expansion.") ("A " (code "syntax") " expression is like a " (code "quote") " expression except that the values of pattern variables appearing within " (code (var "template")) " are inserted into " (code (var "template")) ", and contextual information associated both with the input and with the template is retained in the output to support lexical scoping. A " (code "syntax") " " (code (var "template")) " is identical to a " (code "syntax-rules") "  " (code (var "template")) " and is treated similarly.") ("List and vector structures within the template become true lists or vectors (suitable for direct application of list or vector operations, like " (code "map") " or " (code "vector-ref") ") to the extent that the list or vector structures must be copied to insert the values of pattern variables, and empty lists are never wrapped. For example, " (code "#'(x ...)") ", " (code "#'(a b c)") ", " (code "#'()") " are all lists if " (code "x") ", " (code "a") ", " (code "b") ", and " (code "c") " are pattern variables.") ("The definition of " (code "or") " below is equivalent to the one given in Section " (link "./syntax.html#g135" "8.2") " except that it employs " (code "syntax-case") " and " (code "syntax") " in place of " (code "syntax-rules") ".") ((code "(define-syntax or" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_) #'#f]" (br) "      [(_ e) #'e]" (br) "      [(_ e1 e2 e3 ...)" (br) "       #'(let ([t e1]) (if t t (or e2 e3 ...)))])))")) ("In this version, the " (code "lambda") " expression that produces the transformer is explicit, as are the " (code "syntax") " forms in the output part of each clause. Any " (code "syntax-rules") " form can be expressed with " (code "syntax-case") " by making the " (code "lambda") " expression and " (code "syntax") " expressions explicit. This observation leads to the following definition of " (code "syntax-rules") " in terms of " (code "syntax-case") ".") ((code "(define-syntax syntax-rules" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ (i ...) ((keyword . pattern) template) ...)" (br) "       #'(lambda (x)" (br) "           (syntax-case x (i ...)" (br) "             [(_ . pattern) #'template] ...))])))")) ("An underscore is used in place of each " (code "keyword") " since the first position of each " (code "syntax-rules") " pattern is always ignored.") ("Since the " (code "lambda") " and " (code "syntax") " expressions are implicit in a " (code "syntax-rules") " form, definitions expressed with " (code "syntax-rules") " are often shorter than the equivalent definitions expressed with " (code "syntax-case") ". The choice of which to use when either suffices is a matter of taste, but many transformers that can be written easily with " (code "syntax-case") " cannot be written easily or at all with " (code "syntax-rules") "  (see Section " (link "./syntax.html#g137" "8.4") ").")) ("syntax:s35" ((bold "procedure") ": " (code "(identifier? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is an identifier, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ((code "identifier?") " is often used within fenders to verify that certain subforms of an input form are identifiers, as in the definition of unnamed " (code "let") " below.") ((code "(define-syntax let" (br) "  (lambda (x)" (br) "    (define ids?" (br) "      (lambda (ls)" (br) "        (or (null? ls)" (br) "            (and (identifier? (car ls))" (br) "                 (ids? (cdr ls))))))" (br) "    (syntax-case x ()" (br) "      [(_ ((i e) ...) b1 b2 ...)" (br) "       (ids? #'(i ...))" (br) "       #'((lambda (i ...) b1 b2 ...) e ...)])))")) ("Syntactic extensions ordinarily take the form " (code "(" (var "keyword") " " (var "subform") " ...)") ", but the " (code "syntax-case") " system permits them to take the form of singleton identifiers as well. For example, the keyword " (code "pcar") " in the expression below may be used both as an identifier (in which case it expands into a call to " (code "car") ") or as a structured form (in which case it expands into a call to " (code "set-car!") ").") ((code "(let ([p (cons 0 #f)])" (br) "  (define-syntax pcar" (br) "    (lambda (x)" (br) "      (syntax-case x ()" (br) "        [_ (identifier? x) #'(car p)]" (br) "        [(_ e) #'(set-car! p e)])))" (br) "  (let ([a pcar])" (br) "    (pcar 1)" (br) "    (list a pcar))) " (math "=>") " (0 1)")) ("The fender " (code "(identifier? x)") " is used to recognize the singleton identifier case.")) ("syntax:s37" ((bold "procedure") ": " (code "(free-identifier=? " (var "identifier" (sub "1")) " " (var "identifier" (sub "2")) ")") (br) (bold "procedure") ": " (code "(bound-identifier=? " (var "identifier" (sub "1")) " " (var "identifier" (sub "2")) ")") (br) (bold "returns: ") "see below" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("Symbolic names alone do not distinguish identifiers unless the identifiers are to be used only as symbolic data. The predicates " (code "free-identifier=?") " and " (code "bound-identifier=?") "  are used to compare identifiers according to their " (var "intended use") "  as free references or bound identifiers in a given context.") ((code "free-identifier=?") " is used to determine whether two identifiers would be equivalent if they were to appear as free identifiers in the output of a transformer. Because identifier references are lexically scoped, this means " (code "(free-identifier=? " (var "id" (sub "1")) " " (var "id" (sub "2")) ")") " is true if and only if the identifiers " (code (var "id" (sub "1"))) " and " (code (var "id" (sub "2"))) " refer to the same binding. (For this comparison, two like-named identifiers are assumed to have the same binding if neither is bound.) Literal identifiers (auxiliary keywords) appearing in " (code "syntax-case") " patterns (such as " (code "else") " in " (code "case") "  and " (code "cond") ") are matched with " (code "free-identifier=?") ".") ("Similarly, " (code "bound-identifier=?") " is used to determine whether two identifiers would be equivalent if they were to appear as bound identifiers in the output of a transformer. In other words, if " (code "bound-identifier=?") " returns true for two identifiers, a binding for one will capture references to the other within its scope. In general, two identifiers are " (code "bound-identifier=?") " only if both are present in the original program or both are introduced by the same transformer application (perhaps implicitly---see " (code "datum->syntax") "). " (code "bound-identifier=?") " can be used for detecting duplicate identifiers in a binding construct or for other preprocessing of a binding construct that requires detecting instances of the bound identifiers.") ("The definition below is equivalent to the earlier definition of a simplified version of " (code "cond") " with " (code "syntax-rules") ", except that " (code "else") " is recognized via an explicit call to " (code "free-identifier?") " within a fender rather than via inclusion in the literals list.") ((code "(define-syntax cond" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ (e0 e1 e2 ...))" (br) "       (and (identifier? #'e0) (free-identifier=? #'e0 #'else))" (br) "       #'(begin e1 e2 ...)]" (br) "      [(_ (e0 e1 e2 ...)) #'(if e0 (begin e1 e2 ...))]" (br) "      [(_ (e0 e1 e2 ...) c1 c2 ...)" (br) "       #'(if e0 (begin e1 e2 ...) (cond c1 c2 ...))])))")) ("With either definition of " (code "cond") ", " (code "else") " is not recognized as an auxiliary keyword if an enclosing lexical binding for " (code "else") " exists. For example,") ((code "(let ([else #f])" (br) "  (cond [else (write \"oops\")]))")) ("does " (var "not") " write " (code "\"oops\"") ", since " (code "else") " is bound lexically and is therefore not the same " (code "else") " that appears in the definition of " (code "cond") ".") ("The following definition of unnamed " (code "let") "  uses " (code "bound-identifier=?") " to detect duplicate identifiers.") ((code "(define-syntax let" (br) "  (lambda (x)" (br) "    (define ids?" (br) "      (lambda (ls)" (br) "        (or (null? ls)" (br) "            (and (identifier? (car ls)) (ids? (cdr ls))))))" (br) "    (define unique-ids?" (br) "      (lambda (ls)" (br) "        (or (null? ls)" (br) "            (and (not (memp" (br) "                        (lambda (x) (bound-identifier=? x (car ls)))" (br) "                        (cdr ls)))" (br) "                 (unique-ids? (cdr ls))))))" (br) "    (syntax-case x ()" (br) "      [(_ ((i e) ...) b1 b2 ...)" (br) "       (and (ids? #'(i ...)) (unique-ids? #'(i ...)))" (br) "       #'((lambda (i ...) b1 b2 ...) e ...)])))")) ("With the definition of " (code "let") " above, the expression") ((code "(let ([a 3] [a 4]) (+ a a))")) ("is a syntax violation, whereas") ((code "(let ([a 0])" (br) "  (let-syntax ([dolet (lambda (x)" (br) "                        (syntax-case x ()" (br) "                          [(_ b)" (br) "                           #'(let ([a 3] [b 4]) (+ a b))]))])" (br) "    (dolet a)))")) ("evaluates to " (code "7") " since the identifier " (code "a") " introduced by " (code "dolet") "  and the identifier " (code "a") " extracted from the input form are not " (code "bound-identifier=?") ". Since both occurrences of " (code "a") ", however, if left as free references, would refer to the same binding for " (code "a") ", " (code "free-identifier=?") "  would not distinguish them.") ("Two identifiers that are " (code "free-identifier=?") " may not be " (code "bound-identifier=?") ". An identifier introduced by a transformer may refer to the same enclosing binding as an identifier not introduced by the transformer, but an introduced binding for one will not capture references to the other. On the other hand, identifiers that are " (code "bound-identifier=?") " are " (code "free-identifier=?") ", as long as the identifiers have valid bindings in the context where they are compared.")) ("syntax:s38" ((bold "syntax") ": " (code "(with-syntax ((" (var "pattern") " " (var "expr") ") ...) " (var "body" (sub "1")) " " (var "body" (sub "2")) " ...)") (br) (bold "returns: ") "the values of the final body expression" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("It is sometimes useful to construct a transformer's output in separate pieces, then put the pieces together. " (code "with-syntax") " facilitates this by allowing the creation of local pattern bindings.") ((code (var "pattern")) " is identical in form to a " (code "syntax-case") " pattern. The value of each " (code (var "expr")) " is computed and destructured according to the corresponding " (code (var "pattern")) ", and pattern variables within the " (code (var "pattern")) " are bound as with " (code "syntax-case") " to appropriate portions of the value within the body " (code (var "body" (sub "1")) " " (var "body" (sub "2")) " ...") ", which is processed and evaluated like a " (code "lambda") " body.") ((code "with-syntax") " may be defined as a syntactic extension in terms of " (code "syntax-case") ".") ((code "(define-syntax with-syntax" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ ((p e) ...) b1 b2 ...)" (br) "       #'(syntax-case (list e ...) ()" (br) "           [(p ...) (let () b1 b2 ...)])])))")) ("The following definition of full " (code "cond") "  demonstrates the use of " (code "with-syntax") " to support transformers that employ recursion internally to construct their output.") ((code "(define-syntax cond" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ c1 c2 ...)" (br) "       (let f ([c1 #'c1] [cmore #'(c2 ...)])" (br) "         (if (null? cmore)" (br) "             (syntax-case c1 (else =>)" (br) "               [(else e1 e2 ...) #'(begin e1 e2 ...)]" (br) "               [(e0) #'(let ([t e0]) (if t t))]" (br) "               [(e0 => e1) #'(let ([t e0]) (if t (e1 t)))]" (br) "               [(e0 e1 e2 ...) #'(if e0 (begin e1 e2 ...))])" (br) "             (with-syntax ([rest (f (car cmore) (cdr cmore))])" (br) "               (syntax-case c1 (=>)" (br) "                 [(e0) #'(let ([t e0]) (if t t rest))]" (br) "                 [(e0 => e1) #'(let ([t e0]) (if t (e1 t) rest))]" (br) "                 [(e0 e1 e2 ...)" (br) "                  #'(if e0 (begin e1 e2 ...) rest)]))))])))"))) ("syntax:s40" ((bold "syntax") ": " (code "(quasisyntax " (var "template") " ...)") (br) (bold "syntax") ": " (code "#`" (var "template")) (br) (bold "syntax") ": " (code "(unsyntax " (var "template") " ...)") (br) (bold "syntax") ": " (code "#," (var "template")) (br) (bold "syntax") ": " (code "(unsyntax-splicing " (var "template") " ...)") (br) (bold "syntax") ": " (code "#,@" (var "template")) (br) (bold "returns: ") "see below" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ((code "#`" (var "template")) " is equivalent to " (code "(quasisyntax " (var "template") ")") ", while " (code "#," (var "template")) " is equivalent to " (code "(unsyntax " (var "template") ")") ", and " (code "#,@" (var "template")) " to " (code "(unsyntax-splicing " (var "template") ")") ". The abbreviated forms are converted into the longer forms when the program is read, prior to macro expansion.") ((code "quasisyntax") " is similar to " (code "syntax") ", but it allows parts of the quoted text to be evaluated, in a manner similar to " (code "quasiquote") " (Section " (link "./objects.html#g107" "6.1") ").") ("Within a " (code "quasisyntax") " " (code (var "template")) ", subforms of " (code "unsyntax") " and " (code "unsyntax-splicing") " forms are evaluated, and everything else is treated as ordinary template material, as with " (code "syntax") ". The value of each " (code "unsyntax") " subform is inserted into the output in place of the " (code "unsyntax") " form, while the value of each " (code "unsyntax-splicing") " subform is spliced into the surrounding list or vector structure. " (code "unsyntax") " and " (code "unsyntax-splicing") " are valid only within " (code "quasisyntax") " expressions.") ((code "quasisyntax") " expressions may be nested, with each " (code "quasisyntax") "  introducing a new level of syntax quotation and each " (code "unsyntax") " or " (code "unsyntax-splicing") " taking away a level of quotation. An expression nested within " (var "n") " " (code "quasisyntax") " expressions must be within " (var "n") " " (code "unsyntax") " or " (code "unsyntax-splicing") " expressions to be evaluated.") ((code "quasisyntax") " can be used in place of " (code "with-syntax") " in many cases. For example, the following definition of " (code "case") " employs " (code "quasisyntax") " to construct its output, using internal recursion in a manner similar to the definition of " (code "cond") " given under the description of " (code "with-syntax") " above.") ((code "(define-syntax case" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ e c1 c2 ...)" (br) "       #`(let ([t e])" (br) "           #,(let f ([c1 #'c1] [cmore #'(c2 ...)])" (br) "               (if (null? cmore)" (br) "                   (syntax-case c1 (else)" (br) "                     [(else e1 e2 ...) #'(begin e1 e2 ...)]" (br) "                     [((k ...) e1 e2 ...)" (br) "                      #'(if (memv t '(k ...)) (begin e1 e2 ...))])" (br) "                   (syntax-case c1 ()" (br) "                     [((k ...) e1 e2 ...)" (br) "                      #`(if (memv t '(k ...))" (br) "                            (begin e1 e2 ...)" (br) "                            #,(f (car cmore) (cdr cmore)))]))))])))")) ((code "unsyntax") " and " (code "unsyntax-splicing") " forms that contain zero or more than one subform are valid only in splicing (list or vector) contexts. " (code "(unsyntax " (var "template") " ...)") " is equivalent to " (code "(unsyntax " (var "template") ") ...") ", and " (code "(unsyntax-splicing " (var "template") " ...)") " is equivalent to " (code "(unsyntax-splicing " (var "template") ") ...") ". These forms are primarily useful as intermediate forms in the output of the " (code "quasisyntax") " expander. They support certain useful nested quasiquotation (" (code "quasisyntax") ") idioms [" (link "./bibliography.html#g221" "3") "], such as " (code "#,@#,@") ", which has the effect of a doubly indirect splicing when used within a doubly nested and doubly evaluated " (code "quasisyntax") " expression, as with the nested " (code "quasiquote") " examples shown in Section " (link "./objects.html#g107" "6.1") ".") ((code "unsyntax") " and " (code "unsyntax-splicing") " are auxiliary keywords for " (code "quasisyntax") ". It is a syntax violation to reference these identifiers except in contexts where they are recognized as auxiliary keywords.")) ("syntax:s42" ((bold "procedure") ": " (code "(make-variable-transformer " (var "procedure") ")") (br) (bold "returns: ") "a variable transformer" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("As described in the lead-in to this section, transformers may simply be procedures that accept one argument, a syntax object representing the input form, and return a new syntax object representing the output form. The form passed to a transformer usually represents a parenthesized form whose first subform is the keyword bound to the transformer or just the keyword itself. " (code "make-variable-transformer") " may be used to convert a procedure into a special kind of transformer to which the expander also passes " (code "set!") "  forms in which the keyword appears just after the " (code "set!") " keyword, as if it were a variable to be assigned. This allows the programmer to control what happens when the keyword appears in such contexts. The argument, " (code (var "procedure")) ", should accept one argument.") ((code "(let ([ls (list 0)])" (br) "  (define-syntax a" (br) "    (make-variable-transformer" (br) "      (lambda (x)" (br) "        (syntax-case x ()" (br) "          [id (identifier? #'id) #'(car ls)]" (br) "          [(set! _ e) #'(set-car! ls e)]" (br) "          [(_ e ...) #'((car ls) e ...)]))))" (br) "  (let ([before a])" (br) "    (set! a 1)" (br) "    (list before a ls))) " (math "=>") " (0 1 (1))")) ("This syntactic abstraction can be defined more succinctly using " (code "identifier-syntax") ", as shown in Section " (link "./syntax.html#g135" "8.2") ", but " (code "make-variable-transformer") " can be used to create transformers that perform arbitrary computations, while " (code "identifier-syntax") " is limited to simple term rewriting, like " (code "syntax-rules") ". " (code "identifier-syntax") " can be defined in terms of " (code "make-variable-transformer") ", as shown below.") ((code "(define-syntax identifier-syntax" (br) "  (lambda (x)" (br) "    (syntax-case x (set!)" (br) "      [(_ e)" (br) "       #'(lambda (x)" (br) "           (syntax-case x ()" (br) "             [id (identifier? #'id) #'e]" (br) "             [(_ x (... ...)) #'(e x (... ...))]))]" (br) "      [(_ (id exp1) ((set! var val) exp2))" (br) "       (and (identifier? #'id) (identifier? #'var))" (br) "       #'(make-variable-transformer" (br) "           (lambda (x)" (br) "             (syntax-case x (set!)" (br) "               [(set! var val) #'exp2]" (br) "               [(id x (... ...)) #'(exp1 x (... ...))]" (br) "               [id (identifier? #'id) #'exp1])))])))"))) ("syntax:s44" ((bold "procedure") ": " (code "(syntax->datum " (var "obj") ")") (br) (bold "returns: ") (code (var "obj")) " stripped of syntactic information" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("The procedure " (code "syntax->datum") "  strips all syntactic information from a syntax object and returns the corresponding Scheme \"datum.\" Identifiers stripped in this manner are converted to their symbolic names, which can then be compared with " (code "eq?") ". Thus, a predicate " (code "symbolic-identifier=?") " might be defined as follows.") ((code "(define symbolic-identifier=?" (br) "  (lambda (x y)" (br) "    (eq? (syntax->datum x)" (br) "         (syntax->datum y))))")) ("Two identifiers that are " (code "free-identifier=?") " need not be " (code "symbolic-identifier=?") ": two identifiers that refer to the same binding usually have the same name, but the " (code "rename") " and " (code "prefix") " subforms of the library's " (code "import") " form (page " (link "./libraries.html#desc:import" "345") ") may result in two identifiers with different names but the same binding.")) ("syntax:s45" ((bold "procedure") ": " (code "(datum->syntax " (var "template-identifier") " " (var "obj") ")") (br) (bold "returns: ") "a syntax object" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ((code "datum->syntax") " constructs a syntax object from " (code (var "obj")) " that contains the same contextual information as " (code (var "template-identifier")) ", with the effect that the syntax object behaves as if it were introduced into the code when " (code (var "template-identifier")) " was introduced. The template identifier is often the keyword of an input form, extracted from the form, and the object is often a symbol naming an identifier to be constructed.") ((code "datum->syntax") " allows a transformer to \"bend\" lexical scoping rules by creating " (var "implicit identifiers") "  that behave as if they were present in the input form, thus permitting the definition of syntactic extensions that introduce visible bindings for or references to identifiers that do not appear explicitly in the input form. For example, we can define a " (code "loop") " expression that binds the variable " (code "break") " to an escape procedure within the loop body.") ((code "(define-syntax loop" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(k e ...)" (br) "       (with-syntax ([break (datum->syntax #'k 'break)])" (br) "         #'(call/cc" (br) "             (lambda (break)" (br) "               (let f () e ... (f)))))])))" (br) (br) "(let ([n 3] [ls '()])" (br) "  (loop" (br) "    (if (= n 0) (break ls))" (br) "    (set! ls (cons 'a ls))" (br) "    (set! n (- n 1)))) " (math "=>") " (a a a)")) ("Were we to define " (code "loop") " as") ((code "(define-syntax loop" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ e ...)" (br) "       #'(call/cc" (br) "           (lambda (break)" (br) "             (let f () e ... (f))))])))")) ("the variable " (code "break") " would not be visible in " (code "e ...") ".") ("It is also useful for " (code (var "obj")) " to represent an arbitrary Scheme form, as demonstrated by the following definition of " (code "include") ".") ((code "(define-syntax include" (br) "  (lambda (x)" (br) "    (define read-file" (br) "      (lambda (fn k)" (br) "        (let ([p (open-input-file fn)])" (br) "          (let f ([x (read p)])" (br) "            (if (eof-object? x)" (br) "                (begin (close-port p) '())" (br) "                (cons (datum->syntax k x) (f (read p))))))))" (br) "    (syntax-case x ()" (br) "      [(k filename)" (br) "       (let ([fn (syntax->datum #'filename)])" (br) "         (with-syntax ([(expr ...) (read-file fn #'k)])" (br) "           #'(begin expr ...)))])))")) ((code "(include \"filename\")") " expands into a " (code "begin") " expression containing the forms found in the file named by " (code "\"filename\"") ". For example, if the file " (code "f-def.ss") " contains the expression " (code "(define f (lambda () x))") ", the expression") ((code "(let ([x \"okay\"])" (br) "  (include \"f-def.ss\")" (br) "  (f))")) ("evaluates to " (code "\"okay\"") ".") ("The definition of " (code "include") " uses " (code "datum->syntax") " to convert the objects read from the file into syntax objects in the proper lexical context, so that identifier references and definitions within those expressions are scoped where the " (code "include") " form appears.")) ("syntax:s49" ((bold "procedure") ": " (code "(generate-temporaries " (var "list") ")") (br) (bold "returns: ") "a list of distinct generated identifiers" (br) (bold "libraries: ") (code "(rnrs syntax-case)") ", " (code "(rnrs)")) ("Transformers can introduce a fixed number of identifiers into their output by naming each identifier. In some cases, however, the number of identifiers to be introduced depends upon some characteristic of the input expression. A straightforward definition of " (code "letrec") ", for example, requires as many temporary identifiers as there are binding pairs in the input expression. The procedure " (code "generate-temporaries") " is used to construct lists of temporary identifiers.") ((code (var "list")) " may be any list; its contents are not important. The number of temporaries generated is the number of elements in " (code (var "list")) ". Each temporary is guaranteed to be different from all other identifiers.") ("A definition of " (code "letrec") " that uses " (code "generate-temporaries") " is shown below.") ((code "(define-syntax letrec" (br) "  (lambda (x)" (br) "    (syntax-case x ()" (br) "      [(_ ((i e) ...) b1 b2 ...)" (br) "       (with-syntax ([(t ...) (generate-temporaries #'(i ...))])" (br) "         #'(let ([i #f] ...)" (br) "             (let ([t e] ...)" (br) "               (set! i t)" (br) "               ..." (br) "               (let () b1 b2 ...))))])))")) ("Any transformer that uses " (code "generate-temporaries") " in this fashion can be rewritten to avoid using it, albeit with a loss of clarity. The trick is to use a recursively defined intermediate form that generates one temporary per expansion step and completes the expansion after enough temporaries have been generated. Here is a definition of " (code "let-values") "  (page " (link "./binding.html#desc:let-values" "99") ") that uses this technique to support multiple sets of bindings.") ((code "(define-syntax let-values" (br) "  (syntax-rules ()" (br) "    [(_ () f1 f2 ...) (let () f1 f2 ...)]" (br) "    [(_ ((fmls1 expr1) (fmls2 expr2) ...) f1 f2 ...)" (br) "     (lvhelp fmls1 () () expr1 ((fmls2 expr2) ...) (f1 f2 ...))]))" (br) (br) "(define-syntax lvhelp" (br) "  (syntax-rules ()" (br) "    [(_ (x1 . fmls) (x ...) (t ...) e m b)" (br) "     (lvhelp fmls (x ... x1) (t ... tmp) e m b)]" (br) "    [(_ () (x ...) (t ...) e m b)" (br) "     (call-with-values" (br) "       (lambda () e)" (br) "       (lambda (t ...)" (br) "         (let-values m (let ([x t] ...) . b))))]" (br) "    [(_ xr (x ...) (t ...) e m b)" (br) "     (call-with-values" (br) "       (lambda () e)" (br) "       (lambda (t ... . tmpr)" (br) "         (let-values m (let ([x t] ... [xr tmpr]) . b))))]))")) ("The implementation of " (code "lvhelp") " is complicated by the need to evaluate all of the right-hand-side expressions before creating any of the bindings and by the need to support improper formals lists."))))))