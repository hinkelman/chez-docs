     (assertion-violation 'length \"not a proper list\" x)))" (br) (br) "    (let f ([h x] [t x] [n 0])" (br) "      (if (pair? h)" (br) "          (let ([h (cdr h)])" (br) "            (if (pair? h)" (br) "                (if (eq? h t)" (br) "                    (improper-list)" (br) "                    (f (cdr h) (cdr t) (+ n 2)))" (br) "                (if (null? h)" (br) "                    (+ n 1)" (br) "                    (improper-list))))" (br) "          (if (null? h)" (br) "              n" (br) "              (improper-list))))))" (br) (br) "(length '()) " (math "=>") " 0" (br) "(length '(a b c)) " (math "=>") " 3" (br) "(length '(a b . c)) " (math "=>") " " (var "exception") (br) "(length" (br) "  (let ([ls (list 'a 'b)])" (br) "    (set-cdr! (cdr ls) ls) " (math "=>") " " (var "exception") (br) "    ls))" (br) "(length" (br) "  (let ([ls (list 'a 'b)])" (br) "    (set-car! (cdr ls) ls) " (math "=>") " 2" (br) "    ls))"))) ("objects:s47" ((bold "procedure") ": " (code "(list-ref " (var "list") " " (var "n") ")") (br) (bold "returns: ") "the " (code (var "n")) "th element (zero-based) of " (code (var "list")) (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ((code (var "n")) " must be an exact nonnegative integer less than the length of " (code (var "list")) ". " (code "list-ref") " may be defined without error checks as follows.") ((code "(define list-ref" (br) "  (lambda (ls n)" (br) "    (if (= n 0)" (br) "        (car ls)" (br) "        (list-ref (cdr ls) (- n 1)))))" (br) (br) "(list-ref '(a b c) 0) " (math "=>") " a" (br) "(list-ref '(a b c) 1) " (math "=>") " b" (br) "(list-ref '(a b c) 2) " (math "=>") " c"))) ("objects:s48" ((bold "procedure") ": " (code "(list-tail " (var "list") " " (var "n") ")") (br) (bold "returns: ") "the " (code (var "n")) "th tail (zero-based) of " (code (var "list")) (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ((code (var "n")) " must be an exact nonnegative integer less than or equal to the length of " (code (var "list")) ". The result is not a copy; the tail is " (code "eq?") " to the " (code (var "n")) "th cdr of " (code (var "list")) " (or to " (code (var "list")) " itself, if " (code (var "n")) " is zero).") ((code "list-tail") " may be defined without error checks as follows.") ((code "(define list-tail" (br) "  (lambda (ls n)" (br) "    (if (= n 0)" (br) "        ls" (br) "        (list-tail (cdr ls) (- n 1)))))" (br) (br) "(list-tail '(a b c) 0) " (math "=>") " (a b c)" (br) "(list-tail '(a b c) 2) " (math "=>") " (c)" (br) "(list-tail '(a b c) 3) " (math "=>") " ()" (br) "(list-tail '(a b c . d) 2) " (math "=>") " (c . d)" (br) "(list-tail '(a b c . d) 3) " (math "=>") " d" (br) "(let ([x (list 1 2 3)])" (br) "  (eq? (list-tail x 2)" (br) "       (cddr x))) " (math "=>") " #t"))) ("objects:s49" ((bold "procedure") ": " (code "(append)") (br) (bold "procedure") ": " (code "(append " (var "list") " ... " (var "obj") ")") (br) (bold "returns: ") "the concatenation of the input lists" (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ((code "append") " returns a new list consisting of the elements of the first list followed by the elements of the second list, the elements of the third list, and so on. The new list is made from new pairs for all arguments but the last; the last (which need not be a list) is merely placed at the end of the new structure. " (code "append") " may be defined without error checks as follows.") ((code "(define append" (br) "  (lambda args" (br) "    (let f ([ls '()] [args args])" (br) "      (if (null? args)" (br) "          ls" (br) "          (let g ([ls ls])" (br) "            (if (null? ls)" (br) "                (f (car args) (cdr args))" (br) "                (cons (car ls) (g (cdr ls)))))))))" (br) (br) "(append '(a b c) '()) " (math "=>") " (a b c)" (br) "(append '() '(a b c)) " (math "=>") " (a b c)" (br) "(append '(a b) '(c d)) " (math "=>") " (a b c d)" (br) "(append '(a b) 'c) " (math "=>") " (a b . c)" (br) "(let ([x (list 'b)])" (br) "  (eq? x (cdr (append '(a) x)))) " (math "=>") " #t"))) ("objects:s50" ((bold "procedure") ": " (code "(reverse " (var "list") ")") (br) (bold "returns: ") "a new list containing the elements of " (code (var "list")) " in reverse order" (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ((code "reverse") " may be defined without error checks as follows.") ((code "(define reverse" (br) "  (lambda (ls)" (br) "    (let rev ([ls ls] [new '()])" (br) "      (if (null? ls)" (br) "          new" (br) "          (rev (cdr ls) (cons (car ls) new))))))" (br) (br) "(reverse '()) " (math "=>") " ()" (br) "(reverse '(a b c)) " (math "=>") " (c b a)"))) ("objects:s51" ((bold "procedure") ": " (code "(memq " (var "obj") " " (var "list") ")") (br) (bold "procedure") ": " (code "(memv " (var "obj") " " (var "list") ")") (br) (bold "procedure") ": " (code "(member " (var "obj") " " (var "list") ")") (br) (bold "returns: ") "the first tail of " (code (var "list")) " whose car is equivalent to " (code (var "obj")) ", or " (code "#f") (br) (bold "libraries: ") (code "(rnrs lists)") ", " (code "(rnrs)")) ("These procedures traverse the argument " (code (var "list")) " in order, comparing the elements of " (code (var "list")) " against " (code (var "obj")) ". If an object equivalent to " (code (var "obj")) " is found, the tail of the list whose first element is that object is returned. If the list contains more than one object equivalent to " (code (var "obj")) ", the first tail whose first element is equivalent to " (code (var "obj")) " is returned. If no object equivalent to " (code (var "obj")) " is found, " (code "#f") " is returned. The equivalence test for " (code "memq") " is " (code "eq?") ", for " (code "memv") " is " (code "eqv?") ", and for " (code "member") " is " (code "equal?") ".") ("These procedures are most often used as predicates, but their names do not end with a question mark because they return a useful true value in place of " (code "#t") ". " (code "memq") " may be defined without error checks as follows.") ((code "(define memq" (br) "  (lambda (x ls)" (br) "    (cond" (br) "      [(null? ls) #f]" (br) "      [(eq? (car ls) x) ls]" (br) "      [else (memq x (cdr ls))])))")) ((code "memv") " and " (code "member") " may be defined similarly, with " (code "eqv?") " and " (code "equal?") "  in place of " (code "eq?") ".") ((code "(memq 'a '(b c a d e)) " (math "=>") " (a d e)" (br) "(memq 'a '(b c d e g)) " (math "=>") " #f" (br) "(memq 'a '(b a c a d a)) " (math "=>") " (a c a d a)" (br) (br) "(memv 3.4 '(1.2 2.3 3.4 4.5)) " (math "=>") " (3.4 4.5)" (br) "(memv 3.4 '(1.3 2.5 3.7 4.9)) " (math "=>") " #f" (br) "(let ([ls (list 'a 'b 'c)])" (br) "  (set-car! (memv 'b ls) 'z)" (br) "  ls) " (math "=>") " (a z c)" (br) (br) "(member '(b) '((a) (b) (c))) " (math "=>") " ((b) (c))" (br) "(member '(d) '((a) (b) (c))) " (math "=>") " #f" (br) "(member \"b\" '(\"a\" \"b\" \"c\")) " (math "=>") " (\"b\" \"c\")" (br) (br) "(let ()" (br) "  (define member?" (br) "    (lambda (x ls)" (br) "      (and (member x ls) #t)))" (br) "  (member? '(b) '((a) (b) (c)))) " (math "=>") " #t" (br) (br) "(define count-occurrences" (br) "  (lambda (x ls)" (br) "    (cond" (br) "      [(memq x ls) =>" (br) "       (lambda (ls)" (br) "         (+ (count-occurrences x (cdr ls)) 1))]" (br) "      [else 0])))" (br) (br) "(count-occurrences 'a '(a b c d a)) " (math "=>") " 2"))) ("objects:s52" ((bold "procedure") ": " (code "(memp " (var "procedure") " " (var "list") ")") (br) (bold "returns: ") "the first tail of " (code (var "list")) " for whose car " (code (var "procedure")) " returns true, or " (code "#f") (br) (bold "libraries: ") (code "(rnrs lists)") ", " (code "(rnrs)")) ((code (var "procedure")) " should accept one argument and return a single value. It should not modify " (code (var "list")) ".") ((code "(memp odd? '(1 2 3 4)) " (math "=>") " (1 2 3 4)" (br) "(memp even? '(1 2 3 4)) " (math "=>") " (2 3 4)" (br) "(let ([ls (list 1 2 3 4)])" (br) "  (eq? (memp odd? ls) ls)) " (math "=>") " #t" (br) "(let ([ls (list 1 2 3 4)])" (br) "  (eq? (memp even? ls) (cdr ls))) " (math "=>") " #t" (br) "(memp odd? '(2 4 6 8)) " (math "=>") " #f"))) ("objects:s53" ((bold "procedure") ": " (code "(remq " (var "obj") " " (var "list") ")") (br) (bold "procedure") ": " (code "(remv " (var "obj") " " (var "list") ")") (br) (bold "procedure") ": " (code "(remove " (var "obj") " " (var "list") ")") (br) (bold "returns: ") "a list containing the elements of " (code (var "list")) " with all occurrences of " (code (var "obj")) " removed" (br) (bold "libraries: ") (code "(rnrs lists)") ", " (code "(rnrs)")) ("These procedures traverse the argument " (code (var "list")) ", removing any objects that are equivalent to " (code (var "obj")) ". The elements remaining in the output list are in the same order as they appear in the input list. If a tail of " (code (var "list")) " (including " (code (var "list")) " itself) contains no occurrences of  " (code (var "obj")) ", the corresponding tail of the result list may be the same (by " (code "eq?") ") as the tail of the input list.") ("The equivalence test for " (code "remq") " is " (code "eq?") ", for " (code "remv") " is " (code "eqv?") ", and for " (code "remove") " is " (code "equal?") ".") ((code "(remq 'a '(a b a c a d)) " (math "=>") " (b c d)" (br) "(remq 'a '(b c d)) " (math "=>") " (b c d)" (br) (br) "(remv 1/2 '(1.2 1/2 0.5 3/2 4)) " (math "=>") " (1.2 0.5 3/2 4)" (br) (br) "(remove '(b) '((a) (b) (c))) " (math "=>") " ((a) (c))"))) ("objects:s54" ((bold "procedure") ": " (code "(remp " (var "procedure") " " (var "list") ")") (br) (bold "returns: ") "a list of the elements of " (code (var "list")) " for which " (code (var "procedure")) " returns " (code "#f") (br) (bold "libraries: ") (code "(rnrs lists)") ", " (code "(rnrs)")) ((code (var "procedure")) " should accept one argument and return a single v