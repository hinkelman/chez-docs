ctor")) (br) (bold "libraries: ") (code "(chezscheme)"))) ("objects:s106" ((bold "procedure") ": " (code "(stencil-vector-length " (var "stencil-vector") ")") (br) (bold "returns: ") "the length of " (code (var "stencil-vector")) (br) (bold "libraries: ") (code "(chezscheme)")) ("A stencil vector's length is determined by its mask.  (I.e., this is equivalent to " (code "(fxpopcount (stencil-vector-mask " (var "stencil-vector") "))") ".)") ((code "(stencil-vector-mask '#0vs()) ;= 0" (br) "(stencil-vector-length '#0vs()) ;= 0" (br) "(stencil-vector-mask '#21vs(x y z)) ;= 21" (br) "(stencil-vector-length '#21vs(x y z)) ;= 3"))) ("objects:s107" ((bold "procedure") ": " (code "(stencil-vector-ref " (var "stencil-vector") " " (var "n") ")") (br) (bold "returns: ") "the object at position " (code (var "n")) " in " (code (var "stencil-vector")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "n")) " must be a nonnegative fixnum that is less than the length of " (code (var "stencil-vector")) ".") ("Stencil vector elements are accessed by position, unrelated to the stencil vector's mask (except insofar as the number of valid positions is determined by the mask).") ("Conceptually, each stensil vector element corresponds to a bit in the stencil vector's mask (and vice-versa). To convert a (0-based) bit position " (code (var "bit")) " to an index, where the lowest set bit corresponds to the first element of the stencil vector, use the following calculation:") ((code "(fxpopcount (fxand (stencil-vector-mask " (var "stencil-vector") ") (fx- (fxsll 1 " (var "bit") ") 1)))")) ((code "(stencil-vector-ref '#21vs(x y z) 0) ;= x" (br) "(stencil-vector-ref '#21vs(x y z) 2) ;= z"))) ("objects:s108" ((bold "procedure") ": " (code "(stencil-vector-set! " (var "stencil-vector") " " (var "n") " " (var "obj") ")") (br) (bold "returns: ") "unspecified" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "n")) " must be a nonnegative fixnum that is less than the length of " (code (var "stencil-vector")) ".") ("Installs " (code (var "obj")) " at position " (code (var "n")) " within " (code (var "stencil-vector")) ". See " (code "stencil-vector-ref") " for more information about positions in stencil vectors.") ((code "(define sv (stencil-vector #b10101 'x 'y 'z))" (br) "(stencil-vector-set! sv 1 'why)" (br) "sv " (math "=>") " #21vs(x why z)"))) ("objects:s109" ((bold "procedure") ": " (code "(stencil-vector-update " (var "stencil-vector") " " (var "remove-bits") " " (var "add-bits") " " (var "obj") " ...)") (br) (bold "returns: ") "a new stencil vector adapted from " (code (var "stencil-vector")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "remove-bits")) " and " (code (var "add-bits")) " must be nonnegative fixnums less than " (br) " " (code "(fxsll 1 (stencil-vector-mask-width))") ". Furthermore, all of the following must be true:   " (ul " " (li (code (var "remove-bits")) "  must be a subset of the bits in the mask of " (code (var "stencil-vector")) ". In other words,  " (code "(logand (stencil-vector-mask " (var "stencil-vector") ") " (var "remove-bits") ")") "  must be equal to " (code (var "remove-bits")) ".   ") (li (code (var "add-bits")) " must have a set of bits that do not overlap the subtraction of " (code (var "remove-bits")) " from the mask of  " (code (var "stencil-vector")) ".  In other words   " (code "        (logand" (br) "          (logand (stencil-vector-mask " (var "stencil-vector") ") (lognot " (var "remove-bits") "))" (br) "          " (var "add-bits") ")" (br) "        ") "        must be " (code "0") ".   ") (li "The number of supplied " (code (var "obj")) "s must match " (code "(fxpopcount add-bits)") ".   "))) ("Returns a new stencil vector that has all of the elements of " (code (var "stencil-vector")) ", except the ones identified by the bits in " (code (var "remove-bits")) ". The new stencil vector also has the given " (code (var "obj")) "s at positions determined by " (code (var "add-bits")) ". Elements copied from " (code (var "stencil-vector")) "  to the new vector retain their relative positions corresponding to their bits in the " (code (var "stencil-vector")) " mask. Individual bits in the mask, " (code (var "remove-bits")) ", and " (code (var "add-bits")) " are mapped to element positions as described in the documentation of " (code "stencil-vector-ref") ". The mask of the new stencil vector is the mask of " (code (var "stencil-vector")) " minus " (code (var "remove-bits")) " plus " (code (var "add-bits")) ".") ((code "(define st-vec (stencil-vector #b101 'a 'b))" (br) "(stencil-vector-update st-vec #b0 #b10 'c) " (math "=>") " #7vs(a c b)" (br) "(stencil-vector-update st-vec #b0 #b1000 'c) " (math "=>") " #13vs(a b c)" (br) "st-vec " (math "=>") " #5vs(a b)" (br) "(stencil-vector-update st-vec #b1 #b1 'c) " (math "=>") " #5vs(c b)" (br) "(stencil-vector-update st-vec #b100 #b100 'c) " (math "=>") " #5vs(a c)" (br) "(stencil-vector-update st-vec #b100 #b0) " (math "=>") " #1vs(a)"))) ("objects:s110" ((bold "procedure") ": " (code "(stencil-vector-truncate! " (var "stencil-vector") " " (var "mask") ")") (br) (bold "returns: ") "unspecified" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "mask")) " must be a nonnegative fixnum that does not have more bits set than bits set in the current mask of " (code (var "stencil-vector")) ".") ("Changes the mask of " (code (var "stencil-vector")) " to " (code (var "mask")) ", discarding any elements of the vector beyond the first " (code "(fxpopcount " (var "mask") ")") " elements. There is no requirement that " (code (var "mask")) " has any bits in common with the current mask of " (code (var "stencil-vector")) ".")) ("objects:s119" ((bold "procedure") ": " (code "(box? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is a box, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(box? '#&a) " (math "=>") " #t" (br) "(box? 'a) " (math "=>") " #f" (br) "(box? (box 3)) " (math "=>") " #t"))) ("objects:s120" ((bold "procedure") ": " (code "(box " (var "obj") ")") (br) (bold "returns: ") "a new box containing " (code (var "obj")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(box 'a) " (math "=>") " #&a" (br) "(box (box '(a b c))) " (math "=>") " #&#&(a b c)"))) ("objects:s121" ((bold "procedure") ": " (code "(unbox " (var "box") ")") (br) (bold "returns: ") "contents of " (code (var "box")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(unbox #&a) " (math "=>") " a" (br) "(unbox #&#&(a b c)) " (math "=>") " #&(a b c)" (br) (br) "(let ([b (box \"hi\")])" (br) "  (unbox b)) " (math "=>") " \"hi\""))) ("objects:s122" ((bold "procedure") ": " (code "(set-box! " (var "box") " " (var "obj") ")") (br) (bold "returns: ") "unspecified" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "box")) " must be mutable. " (code "set-box!") " sets the contents of " (code (var "box")) " to " (code (var "obj")) ".") ((code "(let ([b (box 'x)])" (br) "  (set-box! b 'y)" (br) "  b) " (math "=>") " #&y" (br) (br) "(let ([incr!" (br) "       (lambda (x)" (br) "         (set-box! x (+ (unbox x) 1)))])" (br) "  (let ([b (box 3)])" (br) "    (incr! b)" (br) "    (unbox b))) " (math "=>") " 4"))) ("objects:s123" ((bold "procedure") ": " (code "(box-cas! " (var "box") " " (var "old-obj") " " (var "new-obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "box")) " is changed, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "box")) " must be mutable. " (code "box-cas!") " atomically changes the content of " (code (var "box")) " to " (code (var "new-obj")) "  if the replaced content is " (code "eq?") " to " (code (var "old-obj")) ". If the content of " (code (var "box")) " that would be replaced is not " (code "eq?") " to " (code (var "old-obj")) ", then " (code (var "box")) " is unchanged.") ("On an architecture with a weak memory model, " (code "box-cas!") " can spuriously fail, leaving " (code (var "box")) " unchanged and returning " (code "#f") " even if the current value in " (code (var "box")) " is " (code (var "old-obj")) ". On success, no memory ordering is implied, which means that " (code "memory-order-acquire") " and/or " (code "memory-order-release") " may be needed to complete an intended synchronization.") ((code "(define b (box 'old))" (br) "(box-cas! b 'old 'new) " (math "=>") " #t, assuming no spurious failure" (br) "(unbox b) " (math "=>") " 'new" (br) "(box-cas! b 'other 'wrong) " (math "=>") " #f" (br) "(unbox b) " (math "=>") " 'new"))) ("objects:s124" ((bold "procedure") ": " (code "(mutable-box? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is a mutable box, " (code "#f") " otherwise" (br) (bold "procedure") ": " (code "(immutable-box? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is an immutable box, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(mutable-box? (box 1)) " (math "=>") " #t" (br) "(mutable-box? (box-immutable 1)) " (math "=>") " #f" (br) "(immutable-box? (box 1)) " (math "=>") " #f" (br) "(immutable-box? (box-immutable 1)) " (math "=>") " #t" (br) "(mutable-box? (cons 3 4)) " (math "=>") " #f"))) ("objects:s125" ((bold "procedure") ": " (code "(box-immutable " (var "obj") ")") (br) (bold "returns: ") "a new immutable box containing " (code (var "obj")) (br) (bold "libraries: ") (code "(chezscheme)")) ("Boxes are typically intended to support shared, mutable structure, so immutable boxes are not often useful.") ((code "(define b (box-immutable 1))" (br) "(set-box! b 0) " (math "=>") " " (var "exception: not mutable")))) ("objects:s130" ((bold "procedure") ": " (code "(gensym)") (br) (bold "procedure") ": " (code "(gensym " (var "pretty-name") ")") (br) (bold "procedure") ": " (code "(gensym " (var "pretty-name") " " (var "unique-name") ")") (br) (bold "returns: ") "a unique generated symbol" (br) (bold "libraries: ") (code "(chezscheme)")) ("Each call to " (code "gensym") " returns a unique generated symbol, or " (var "gensym") ". Each generated symbol has two names: a \"pretty\" name and a \"unique\" name.") ("In the first form above, the pretty name is formed (lazily---see below) by combining an internal prefix with the value of an internal counter. After each name is formed, the internal counter is incremented. The parameters " (code "gensym-prefix") " and " (code "gensym-count") ", described below, may be used to access and set the internal prefix and counter. By default, the prefix is the single-character string " (code "\"g\"") ". In the second and third forms, the pretty name of the new gensym is " (code (var "pretty-name")) ", which must be a string. The pretty name of a gensym is returned by the procedure " (code "symbol->string") ".") ("In both the first and second forms, the unique name is an automatically generated globally unique name. Globally unique names are constructed (lazily---see below) from the combination of a universally unique identifier and an internal counter. In the third form of gensym, the unique name of the new gensym is " (code (var "unique-name")) ", which must be a string. The unique name of a gensym may be obtained via the procedure " (code "gensym->unique-string") ".") ("The unique name allows gensyms to be written in such a way that they can be read back and reliably commonized on input. The syntax for gensyms includes both the pretty name and the unique name, as shown in the example below:") ((code "(gensym) " (math "=>") " #{g0 bcsfg5eq4e9b3h9o-a}")) ("When the parameter " (code "print-gensym") " is set to " (code "pretty") ", the printer prints the pretty name only, with a " (code "#:") " syntax, so") ((code "(parameterize ([print-gensym 'pretty])" (br) "  (write (gensym)))")) ("prints " (code "#:g0") ".") ("When the reader sees the " (code "#:") " syntax, it produces a gensym with the given pretty name, but the original unique name is lost.") ("When the parameter is set to " (code "#f") ", the printer prints just the pretty name, so") ((code "(parameterize ([print-gensym #f])" (br) "  (write (gensym)))")) ("prints " (code "g0") ". This is useful only when gensyms do not need to be read back in as gensyms.") ("In order to reduce construction and (when threaded) synchronization overhead when gensyms are frequently created but rarely printed or stored in an object file, generated pretty and unique names are created lazily, i.e., not until first requested, either by the printer, fasl writer, or explicitly by one of the procedures " (code "symbol->string") "  or " (code "gensym->unique-string") ". In addition, a gensym is not placed into the system's internal symbol table (the oblist; see page " (link "./objects.html#desc:oblist" "179") ") until the unique name is requested. This allows a gensym to be reclaimed by the storage manager if no references to the gensym exist and no unique name exists by which to access it, even if it has a top-level binding or a nonempty property list.") ((code "(define x (gensym))" (br) "x                         " (math "=>") " #{g2 bcsfg5eq4e9b3h9o-c}" (br) "(symbol->string x)        " (math "=>") " \"g2\"" (br) "(gensym->unique-string x) " (math "=>") " \"bcsfg5eq4e9b3h9o-c\"")) ("Gensyms subsume the notion of " (var "uninterned symbols") " supported by earlier versions of " (var "Chez Scheme") ". For most purposes, the predicate " (code "uninterned-symbol?") " has been replaced by " (code "gensym?") ".")) ("objects:s138" ((bold "thread parameter") ": " (code "gensym-prefix") (br) (bold "thread parameter") ": " (code "gensym-count") (br) (bold "libraries: ") (code "(chezscheme)")) ("The parameters " (code "gensym-prefix") " and " (code "gensym-count") " are used to access and set the internal prefix and counter from which the pretty name of a gensym is generated when " (code "gensym") " is not given an explicit string argument. " (code "gensym-prefix") " defaults to the string " (code "\"g\"") " and may be set to any object. " (code "gensym-count") " starts at 0 and may be set to any nonnegative integer.") ("As described above, " (var "Chez Scheme") " delays the creation of the pretty name until the name is first requested by the printer or by an explicit call to " (code "symbol->string") ". These parameters are not consulted until that time; setting them when " (code "gensym") " is called thus has no effect on the generated name.") ((code "(let ([x (parameterize ([gensym-prefix \"genny\"]" (br) "                        [gensym-count 17]" (br) "                        [print-gensym 'pretty])" (br) "           (gensym))])" (br) "  (format \"~s\" x))                       " (math "=>") " \"#{g4 bcsfg5eq4e9b3h9o-e}\"" (br) "(let ([x (gensym)])" (br) "  (parameterize ([gensym-prefix \"genny\"]" (br) "                 [gensym-count 17]" (br) "                 [print-gensym #f])" (br) "    (format \"~s\" (gensym))))             " (math "=>") " \"genny17\""))) ("objects:s140" ((bold "procedure") ": " (code "(gensym->unique-string " (var "gensym") ")") (br) (bold "returns: ") "the unique name of " (code (var "gensym")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(gensym->unique-string (gensym)) " (math "=>") " \"bd3kufa7ypjcuvut-g\""))) ("objects:s141" ((bold "procedure") ": " (code "(gensym? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is a gensym, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(gensym? (string->symbol \"z\")) " (math "=>") " #f" (br) "(gensym? (gensym \"z\")) " (math "=>") " #t" (br) "(gensym? 'a) " (math "=>") " #f" (br) "(gensym? 3) " (math "=>") " #f" (br) "(gensym? (gensym)) " (math "=>") " #t" (br) "(gensym? '#{g2 bcsfg5eq4e9b3h9o-c}) " (math "=>") " #t"))) ("objects:s142" ((bold "procedure") ": " (code "(string->uninterned-symbol " (var "str") ")") (br) (bold "returns: ") "a fresh uninterned symbol" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "str")) " must be a string.") ("Returns an uninterned symbol that prints the same as a symbol constructed from " (code (var "str")) ", but which is not " (code "eq?") " to any other symbol.") ("When an uninterned symbol is converted by the fasl writer, the fasl reader will allocate a fresh uninterned symbol each time the fasl stream is read. Multiple occurrences of the same uninterned symbol in the fasl writer's argument will become multiple occurrences of the same new uninterned symbol in the fasl reader's result for the stream.") ((code "(string->uninterned-symbol \"z\") " (math "=>") " z" (br) "(uninterned-symbol? (string->uninterned-symbol \"z\")) " (math "=>") " #t" (br) "(symbol? (string->uninterned-symbol \"z\")) " (math "=>") " #t" (br) "(gensym? (string->uninterned-symbol \"z\")) " (math "=>") " #f"))) ("objects:s143" ((bold "procedure") ": " (code "(uninterned-symbol? " (var "obj") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "obj")) " is an uninterned symbol, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code "(uninterned-symbol? (string->symbol \"z\")) " (math "=>") " #f" (br) "(uninterned-symbol? (gensym \"z\")) " (math "=>") " #f" (br) "(uninterned-symbol? (string->uninterned-symbol \"z\")) " (math "=>") " #t"))) ("objects:s144" ((bold "procedure") ": " (code "(putprop " (var "symbol") " " (var "key") " " (var "value") ")") (br) (bold "returns: ") "unspecified" (br) (bold "libraries: ") (code "(chezscheme)")) ((var "Chez Scheme") " associates a " (var "property list") " with each symbol, allowing multiple " (code (var "key-value")) " pairs to be stored directly with the symbol. New key-value pairs may be placed in the property list or retrieved in a manner analogous to the use of association lists, using the procedures " (code "putprop") " and " (code "getprop") ". Property lists are often used to store information related to the symbol itself. For example, a natural language program might use symbols to represent words, using their property lists to store information about use and meaning.") ((code "putprop") " associates " (code (var "value")) " with " (code (var "key")) " on the property list of " (code (var "symbol")) ". " (code (var "key")) " and " (code (var "value")) " may be any types of object, although " (code (var "key")) " is typically a symbol.") ((code "putprop") " may be used to establish a new property or to change an existing property.") ("See the examples under " (code "getprop") " below.")) ("objects:s146" ((bold "procedure") ": " (code "(getprop " (var "symbol") " " (var "key") ")") (br) (bold "procedure") ": " (code "(getprop " (var "symbol") " " (var "key") " " (var "default") ")") (br) (bold "returns: ") "the value associated with " (code (var "key")) " on the property list of " (code (var "symbol")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code "getprop") " searches the property list of " (code (var "symbol")) " for a key identical to " (code (var "key")) " (in the sense of " (code "eq?") "), and returns the value associated with this key, if any. If no value is associated with " (code (var "key")) " on the property list of " (code (var "symbol")) ", " (code "getprop") " returns " (code (var "default")) ", or " (code "#f") " if the " (code (var "default")) " argument is not supplied.") ((code "(putprop 'fred 'species 'snurd)" (br) "(putprop 'fred 'age 4)  " (br) "(putprop 'fred 'colors '(black white))" (br) (br) "(getprop 'fred 'species) " (math "=>") " snurd" (br) "(getprop 'fred 'colors) " (math "=>") " (black white)" (br) "(getprop 'fred 'nonkey) " (math "=>") " #f" (br) "(getprop 'fred 'nonkey 'unknown) " (math "=>") " unknown" (br) " " (br) "(putprop 'fred 'species #f)" (br) "(getprop 'fred 'species 'unknown) " (math "=>") " #f"))) ("objects:s148" ((bold "procedure") ": " (code "(remprop " (var "symbol") " " (var "key") ")") (br) (bold "returns: ") "unspecified" (br) (bold "libraries: ") (code "(chezscheme)")) ((code "remprop") " removes the property with key " (code (var "key")) " from the property list of " (code (var "symbol")) ", if such a property exists.") ((code "(putprop 'fred 'species 'snurd)" (br) "(getprop 'fred 'species) " (math "=>") " snurd" (br) (br) "(remprop 'fred 'species)" (br) "(getprop 'fred 'species 'unknown) " (math "=>") " unknown"))) ("objects:s150" ((bold "procedure") ": " (code "(property-list " (var "symbol") ")") (br) (bold "returns: ") "a copy of the internal property list for " (code (var "symbol")) (br) (bold "libraries: ") (code "(chezscheme)")) ("A property list is a list of alternating keys and values, i.e., " (code "(" (var "key") " " (var "value") " ...)") ".") ((code "(putprop 'fred 'species 'snurd)" (br) "(putprop 'fred 'colors '(black white))" (br) "(property-list 'fred) " (math "=>") " (colors (black white) species snurd)"))) ("objects:s151" ((bold "procedure") ": " (code "(oblist)") (br) (bold "returns: ") "a list of interned symbols" (br) (bold "libraries: ") (code "(chezscheme)")) ("The system maintains an internal symbol table used to insure that any two occurrences of the same symbol name resolve to the same symbol object. The " (code "oblist") " procedure returns a list of the symbols currently in this symbol table.") ("The list of interned symbols grows when a new symbol is introduced into the system or when the unique name of a gensym (see page " (link "./objects.html#desc:gensym" "175") ") is requested. It shrinks when the garbage collector determines that it is safe to discard a symbol. It is safe to discard a symbol only if the symbol is not accessible except through the oblist, has no top-level binding, and has no properties on its property list.") ((code "(if (memq 'tiger (oblist)) 'yes 'no) " (math "=>") " yes" (br) "(equal? (oblist) (oblist)) " (math "=>") " #t" (br) "(= (length (oblist)) (length (oblist))) " (math "=>") " #t " (var "or") " #f")) ("The first example above follows from the property that all interned symbols are in the oblist from the time they are read, which happens prior to evaluation. The second example follows from the fact that no symbols can be removed from the oblist while references to those symbols exist, in this case, within the list returned by the first call to " (code "oblist") " (whichever call is performed first). The expression in the third example can return " (code "#f") " only if a garbage collection occurs sometime between the two calls to " (code "oblist") ", and only if one or more symbols are removed from the oblist by that collection.")) ("objects:s152" ((bold "procedure") ": " (code "(void)") (br) (bold "returns: ") "the void object" (br) (bold "libraries: ") (code "(chezscheme)")) ((code "void") " is a procedure of no arguments that returns the void object. It can be used to force expressions that are used for effect or whose values are otherwise unspecified to evaluate to a consistent, trivial value. Since most " (var "Chez Scheme") " operations that are used for effect return the void object, however, it is rarely necessary to explicitly invoke the " (code "void") " procedure.") ("Since the void object is used explicitly as an \"unspecified\" value, it is a bad idea to use it for any other purpose or to count on any given expression evaluating to the void object.") ("The default waiter printer suppresses the void object; that is, nothing is printed for expressions that evaluate to the void object.") ((code "(eq? (void) #f) " (math "=>") " #f" (br) "(eq? (void) #t) " (math "=>") " #f" (br) "(eq? (void) '()) " (math "=>") " #f"))) ("objects:s153" ((bold "procedure") ": " (code "(sort " (var "predicate") " " (var "list") ")") (br) (bold "procedure") ": " (code "(sort! " (var "predicate") " " (var "list") ")") (br) (bold "returns: ") "a list containing the elements of " (code (var "list")) " sorted according to " (code (var "predicate")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code "sort") " is identical to the Revised" (sup "6") " Report " (code "list-sort") ", and " (code "sort!") " is a destructive version of " (code "sort") ", i.e., it reuses pairs from the input list to form the output list.") ((code "(sort < '(3 4 2 1 2 5)) " (math "=>") " (1 2 2 3 4 5)" (br) "(sort! < '(3 4 2 1 2 5)) " (math "=>") " (1 2 2 3 4 5)"))) ("objects:s154" ((bold "procedure") ": " (code "(merge " (var "predicate") " " (var "list" (sub "1")) " " (var "list" (sub "2")) ")") (br) (bold "procedure") ": " (code "(merge! " (var "predicate") " " (var "list" (sub "1")) " " (var "list" (sub "2")) ")") (br) (bold "returns: ") (code (var "list" (sub "1"))) " merged with " (code (var "list" (sub "2"))) " in the order specified by " (code (var "predicate")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "predicate")) " should be a procedure that expects two arguments and returns " (code "#t") " if its first argument must precede its second in the merged list. It should not have any side effects. That is, if " (code (var "predicate")) " is applied to two objects " (code (var "x")) " and " (code (var "y")) ", where " (code (var "x")) " is taken from the second list and " (code (var "y")) "  is taken from the first list, it should return true only if " (code (var "x")) " should appear before " (code (var "y")) "  in the output list. If this constraint is met, " (code "merge") " and " (code "merge!") " are stable, in that items from " (code (var "list" (sub "1"))) " are placed in front of equivalent items from " (code (var "list" (sub "2"))) " in the output list. Duplicate elements are included in the merged list.") ((code "merge!") " combines the lists destructively, using pairs from the input lists to form the output list.") ((code "(merge char<?" (br) "       '(#\\a #\\c)" (br) "       '(#\\b #\\c #\\d)) " (math "=>") " (#\\a #\\b #\\c #\\c #\\d)" (br) "(merge <" (br) "       '(1/2 2/3 3/4)" (br) "       '(0.5 0.6 0.7)) " (math "=>") " (1/2 0.5 0.6 2/3 0.7 3/4)"))) ("objects:s155" ((bold "procedure") ": " (code "(hashtable-cell " (var "hashtable") " " (var "key") " " (var "default") ")") (br) (bold "returns: ") "a pair (see below)" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "hashtable")) " must be a mutable hashtable. " (code (var "key")) " and " (code (var "default")) " may be any Scheme values.") ("If no value is associated with " (code (var "key")) " in " (code (var "hashtable")) ", " (code "hashtable-cell") " modifies " (code (var "hashtable")) " to associate " (code (var "key")) " with " (code (var "default")) ". It returns a pair whose car is " (code (var "key")) " and whose cdr is the associated value. Changing the cdr of this pair effectively updates the table to associate " (code (var "key")) " with a new value. The " (code (var "key")) " in the car field should not be changed. The advantage of this procedure over the Revised" (sup "6") " Report procedures for manipulating hashtable entries is that the value associated with a key may be read or written many times with only a single hashtable lookup.") ((code "(define ht (make-eq-hashtable))" (br) "(define v (vector 'a 'b 'c))" (br) "(define cell (hashtable-cell ht v 3))" (br) "cell " (math "=>") " (#(a b c) . 3)" (br) "(hashtable-ref ht v 0) " (math "=>") " 3" (br) "(set-cdr! cell 4)" (br) "(hashtable-ref ht v 0) " (math "=>") " 4"))) ("objects:s156" ((bold "procedure") ": " (code "(hashtable-ref-cell " (var "hashtable") " " (var "key") ")") (br) (bold "returns: ") "a pair if " (code (var "key")) " is in " (code (var "hashtable")) ", " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "hashtable")) " must be a mutable hashtable. " (code (var "key")) " may be any Scheme value.") ("If " (code (var "key")) " is associated with a value in " (code (var "hashtable")) ", then " (code "hashtable-ref-cell") " returns a pair whose car is " (code (var "key")) " and whose cdr is the associated value. Changing the cdr of this pair effectively updates the table to associate " (code (var "key")) " with a new value. The " (code (var "key")) " in the car field should not be changed.") ("If " (code (var "key")) " is not in " (code (var "hashtable")) ", then " (code "#f") " is returned.") ((code "(define ht (make-eq-hashtable))" (br) "(define v (vector 'a 'b 'c))" (br) "(hashtable-ref-cell ht v) " (math "=>") " #f" (br) "(hashtable-set! ht v 3)" (br) "(define cell (hashtable-ref-cell ht v))" (br) "cell " (math "=>") " ((#a b c) . 3)" (br) "(hashtable-ref ht v 0) " (math "=>") " 3" (br) "(set-cdr! cell 4)" (br) "(hashtable-ref ht v 0) " (math "=>") " 4"))) ("objects:s157" ((bold "procedure") ": " (code "(hashtable-keys " (var "hashtable") ")") (br) (bold "procedure") ": " (code "(hashtable-keys " (var "hashtable") " " (var "size") ")") (br) (bold "returns: ") "a vector containing the keys in " (code (var "hashtable")) (br) (bold "libraries: ") (code "(chezscheme)")) ("Identical to the Revised" (sup "6") " Report counterpart, but allowing an optional " (code (var "size")) " argument. If " (code (var "size")) " is specified, then it must be an exact, nonnegative integer; the result vector will contain " (code "(min " (var "size") " (hashtable-size " (var "hashtable") "))") " elements. Different calls to " (code "hashtable-keys") "  with a " (code (var "size")) " less than " (code "(hashtable-size " (var "hashtable") ")") "  may return different subsets of " (code (var "hashtable")) "'s keys.") ((code "(define ht (make-eq-hashtable))" (br) "(hashtable-set! ht 'a \"one\")" (br) "(hashtable-set! ht 'b \"two\")" (br) "(hashtable-set! ht 'c \"three\")" (br) "(hashtable-keys ht) " (math "=>") " #(a b c) " (var "or any permutation") (br) "(hashtable-keys ht 1) " (math "=>") " #(a) " (var "or") " #(b) " (var "or") " #(c)"))) ("objects:s158" ((bold "procedure") ": " (code "(hashtable-values " (var "hashtable") ")") (br) (bold "procedure") ": " (code "(hashtable-values " (var "hashtable") " " (var "size") ")") (br) (bold "returns: ") "a vector containing the values in " (code (var "hashtable")) (br) (bold "libraries: ") (code "(chezscheme)")) ("Each value is the value of one of the keys in " (code (var "hashtable")) ". Duplicate values are not removed. The values may appear in any order in the returned vector. If " (code (var "size")) " is specified, then it must be an exact, nonnegative integer; the result vector will contain " (code "(min " (var "size") " (hashtable-size " (var "hashtable") "))") " elements. Different calls to " (code "hashtable-values") "  with a " (code (var "size")) " less than " (code "(hashtable-size " (var "hashtable") ")") "  may return different subsets of " (code (var "hashtable")) "'s values.") ((code "(define ht (make-eq-hashtable))" (br) "(define p1 (cons 'a 'b))" (br) "(define p2 (cons 'a 'b))" (br) "(hashtable-set! ht p1 \"one\")" (br) "(hashtable-set! ht p2 \"two\")" (br) "(hashtable-set! ht 'q \"two\")" (br) "(hashtable-values ht) " (math "=>") " #(\"one\" \"two\" \"two\") " (var "or any permutation") (br) "(hashtable-values ht 1) " (math "=>") " #(\"one\") " (var "or") " #(\"two\")")) ("This procedure is equivalent to calling " (code "hashtable-entries") " and returning only the second result, but it is more efficient since the separate vector of keys need not be created.")) ("objects:s159" ((bold "procedure") ": " (code "(hashtable-entries " (var "hashtable") ")") (br) (bold "procedure") ": " (code "(hashtable-entries " (var "hashtable") " " (var "size") ")") (br) (bold "returns: ") "two vectors containing the keys and values in " (code (var "hashtable")) (br) (bold "libraries: ") (code "(chezscheme)")) ("Identical to the Revised" (sup "6") " Report counterpart, but allowing an optional " (code (var "size")) " argument. If " (code (var "size")) " is specified, then it must be an exact, nonnegative integer; the result vectors will each contain " (code "(min " (var "size") " (hashtable-size " (var "hashtable") "))") " elements. Different calls to " (code "hashtable-entries") "  with a " (code (var "size")) " less than " (code "(hashtable-size " (var "hashtable") ")") "  may return different subsets of " (code (var "hashtable")) "'s entries.") ((code "(define ht (make-eq-hashtable))" (br) "(hashtable-set! ht 'a \"one\")" (br) "(hashtable-set! ht 'b \"two\")" (br) "(hashtable-entries ht) " (math "=>") " #(a b) #(\"one\" \"two\") " (var "or the other permutation") (br) "(hashtable-entries ht 1) " (math "=>") " #(a) #(\"one\") " (var "or") " #(b) #(\"two\") "))) ("objects:s160" ((bold "procedure") ": " (code "(hashtable-cells " (var "hashtable") ")") (br) (bold "procedure") ": " (code "(hashtable-cells " (var "hashtable") " " (var "size") ")") (br) (bold "returns: ") "a vector of up to " (code (var "size")) " elements containing the cells of " (code (var "hashtable")) (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "hashtable")) " must be a mutable hashtable.") ("Each element of the result vector is the value of one of the cells in " (code (var "hashtable")) ". The cells may appear in any order in the returned vector. If " (code (var "size")) " is specified, then it must be an exact, nonnegative integer; the result vector will contain " (code "(min " (var "size") " (hashtable-size " (var "hashtable") "))") " elements. If " (code (var "size")) " is not specified, then the result vector has " (code "(hashtable-size " (var "hashtable") ")") " elements. Different calls to " (code "hashtable-cells") "  with a " (code (var "size")) " less than " (code "(hashtable-size " (var "hashtable") ")") "  may return different subsets of " (code (var "hashtable")) "'s cells.") ("Changing the cdr of a pair in the result vector effectively updates the table to associate car of the pair with a new value. The car of a pair in the result vector should not be changed.") ((code "(define ht (make-eqv-hashtable))" (br) "(hashtable-set! ht 1 'one)" (br) "(hashtable-set! ht 2 'two)" (br) "(hashtable-cells ht) " (math "=>") " #((1 . one) (2 . two)) " (var "or") " #((2 . two) (1 . one))" (br) "(hashtable-cells ht 1) " (math "=>") " #((1 . one)) " (var "or") " #((2 . two))" (br) "(hashtable-cells ht 0) " (math "=>") " #()"))) ("objects:s161" ((bold "procedure") ": " (code "(make-weak-eq-hashtable)") (br) (bold "procedure") ": " (code "(make-weak-eq-hashtable " (var "size") ")") (br) (bold "procedure") ": " (code "(make-weak-eqv-hashtable)") (br) (bold "procedure") ": " (code "(make-weak-eqv-hashtable " (var "size") ")") (br) (bold "procedure") ": " (code "(make-weak-hashtable " (var "hash") " " (var "equiv?") ")") (br) (bold "procedure") ": " (code "(make-weak-hashtable " (var "hash") " " (var "equiv?") " " (var "size") ")") (br) (bold "returns: ") "a new weak hashtable" (br) (bold "libraries: ") (code "(chezscheme)")) ("Like the Revised" (sup "6") " Report procedures " (code "make-eq-hashtable") ", " (code "make-eqv-hashtable") ", and " (code "make-hashtable") ", except the keys of the hashtable are held weakly, i.e., they are not protected from the garbage collector. Keys reclaimed by the garbage collector are removed from the table, and their associated values are dropped the next time the table is modified, if not sooner.") ("Values in the hashtable are referenced normally as long as the key is not reclaimed, since keys are paired values using weak pairs. Consequently, if a value in the hashtable refers to its own key, then garbage collection is prevented from reclaiming the key. See " (code "make-ephemeron-hashtable") " and related functions.") ("A copy of a weak hashtable created by " (code "hashtable-copy") " is also weak. If the copy is immutable, inaccessible keys may still be dropped from the hashtable, even though the contents of the table is otherwise unchanging. The effect of this can be observed via " (code "hashtable-keys") " and " (code "hashtable-entries") ".") ((code "(define ht1 (make-weak-eq-hashtable))" (br) "(define ht2 (