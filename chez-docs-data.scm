th "=>") " (1 b c)"))) ("objects:s41" ((bold "procedure") ": " (code "(set-cdr! " (var "pair") " " (var "obj") ")") (br) (bold "returns: ") "unspecified" (br) (bold "libraries: ") (code "(rnrs mutable-pairs)")) ((code "set-cdr!") " changes the cdr of " (code (var "pair")) " to " (code (var "obj")) ".") ((code "(let ([x (list 'a 'b 'c)])" (br) "  (set-cdr! x 1)" (br) "  x) " (math "=>") " (a . 1)"))) ("objects:s42" ((bold "procedure") ": " (code "(caar " (var "pair") ")") (br) (bold "procedure") ": " (code "(cadr " (var "pair") ")") "                                                    " (math "⋮") " " (br) (bold "procedure") ": " (code "(cddddr " (var "pair") ")") (br) (bold "returns: ") "the caar, cadr, ..., or cddddr of " (code (var "pair")) (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ("These procedures are defined as the composition of up to four " (code "car") "s and " (code "cdr") "s. The " (code "a") "'s and " (code "d") "'s between the " (code "c") " and " (code "r") " represent the application of " (code "car") " or " (code "cdr") " in order from right to left. For example, the procedure " (code "cadr") " applied to a pair yields the " (code "car") "  of the " (code "cdr") " of the pair and is equivalent to " (code "(lambda (x) (car (cdr x)))") ".") ((code "(caar '((a))) " (math "=>") " a" (br) "(cadr '(a b c)) " (math "=>") " b" (br) "(cdddr '(a b c d)) " (math "=>") " (d)" (br) "(cadadr '(a (b c))) " (math "=>") " c"))) ("objects:s43" ((bold "procedure") ": " (code "(list " (var "obj") " ...)") (br) (bold "returns: ") "a list of " (code (var "obj") " ...") (br) (bold "libraries: ") (code "(rnrs base)") ", " (code "(rnrs)")) ((code "list") " is equivalent to " (code "(lambda x x)") ".") ((code "(list) " (math "=>") " ()" (br) "(list 1 2 3) " (math "=>") " (1 2 3)" (br) "(list 3 2 1) " (math "=>") " (3 2 1)"))) ("objects:s44" ((bold "procedure") ": " (code "(cons* " (var "obj") " ... " (var "final-obj") ")") (br) (bold "returns: ") "a