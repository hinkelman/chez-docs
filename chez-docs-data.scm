on takes precedence). Thus, " (code "reference*-address->object") "  and " (code "bytevector-reference*-ref") " are mainly useful for an address that is known to be either a bytevector reference, an flvector reference, or a foreign address.") ("If " (code (var "addr")) " is not a foreign address and does not reference a valid Scheme object then behavior is undefined.")) ("foreign:s187" ((bold "procedure") ": " (code "(foreign-entry? " (var "entry-name") ")") (br) (bold "returns: ") (code "#t") " if " (code (var "entry-name")) " is an existing foreign procedure entry point, " (code "#f") " otherwise" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "entry-name")) " must be a string. " (code "foreign-entry?") " may be used to determine if an entry exists for a foreign procedure.") ("The following examples assume that  a library that defines " (code (var "strlen")) " has been loaded via " (code "load-shared-object") " or that " (code "strlen") " has been registered via one of the other methods described in this section.") ((code "(foreign-entry? \"strlen\") " (math "=>") " #t" (br) "((foreign-procedure \"strlen\"" (br) "    (string) size_t)" (br) " \"hey!\") " (math "=>") " 4"))) ("foreign:s188" ((bold "procedure") ": " (code "(foreign-entry " (var "entry-name") ")") (br) (bold "returns: ") "the address of " (code (var "entry-name")) " as an exact integer" (br) (bold "libraries: ") (code "(chezscheme)")) ((code (var "entry-name")) " must be a string naming an existing foreign entry point.") ("The following examples assume that  a library that defines " (code (var "strlen")) " has been loaded via " (code "load-shared-object") " or that " (code "strlen") " has been registered via one of the other methods described in this section.") ((code "(let ([addr (foreign-entry \"strlen\")])" (br) "  (and (integer? addr) (exact? addr))) " (math "=>") " #t" (br) (br) "(define-ftype strlen-type (function (string) size_t))" (br) "(define strlen" (br) "  (ftype-ref strlen-t